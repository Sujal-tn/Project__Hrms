@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<Project_Hrms.Models.TerminationViewModels>

@{
    ViewData["Title"] = "Termination";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Terminations</h2>

        <button type="button"
                class="btn"
                style="background-color: #F26522; color: white;"
                data-bs-toggle="modal"
                data-bs-target="#addTerminationModal">
            Add Termination
        </button>
    </div>

    <!-- Notifications -->
    @if (TempData["addmssg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["addmssg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Termination Card -->
    <div class="card">

        <!-- Card Header -->
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

            <h5 class="mb-0">Termination List</h5>

            <div class="d-flex align-items-center gap-2 flex-wrap">

                <!-- Sorting Filter -->
                <select id="sortFilter"
                        class="form-select"
                        style="width: 150px;">

                    <option value="">Sort By</option>
                    <option value="asc">Employee A-Z</option>
                    <option value="desc">Employee Z-A</option>
                </select>

                <!-- Export Dropdown -->
                <div class="dropdown">

                    <button type="button"
                            class="btn dropdown-toggle"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Export
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportPdf">
                                Export as PDF
                            </button>
                        </li>

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportExcel">
                                Export as Excel
                            </button>
                        </li>

                    </ul>

                </div>

            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body">

            <div class="table-responsive">

                <table id="terminationTable"
                       class="table table-bordered table-hover align-middle w-100">

                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Employee Name</th>
                            <th>Termination Type</th>
                            <th>Notice Date</th>
                            <th>Termination Date</th>
                            <th>Reason</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null)
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>@item.TerminationId</td>

                                    <td>@item.EmployeeName</td>

                                    <td>@item.TerminationType</td>

                                    <td>@item.NoticeDate.ToString("yyyy-MM-dd")</td>

                                    <td>@item.ResignDate.ToString("yyyy-MM-dd")</td>

                                    <td>@item.Reason</td>

                                    <td style ="white-space: nowrap;">
                                        <div class="d-inline-flex align-items-center gap-1">
                                        <!-- Edit Button -->
                                        <button type="button"
                                                class="btn btn-sm editTerminationButton me-1"
                                                data-id="@item.TerminationId"
                                                data-userid="@item.UserId"
                                                data-terminationtype="@item.TerminationType"
                                                data-noticedate="@item.NoticeDate.ToString("yyyy-MM-dd")"
                                                data-resigndate="@item.ResignDate.ToString("yyyy-MM-dd")"
                                                data-reason="@item.Reason"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editTerminationModal"
                                                title="Edit"
                                                style="background-color: #0d6efd !important; color: #ffffff !important; border: 1px solid #0d6efd !important; padding: 4px 8px; border-radius: 4px;">

                                            <i class="bi bi-pencil-square" style="color: #ffffff !important;"></i>

                                        </button>

                                        <!-- Delete Button -->
                                        <a asp-controller="Termination"
                                           asp-action="DeleteTermination"
                                           asp-route-id="@item.TerminationId"
                                           class="btn btn-sm"
                                           onclick="return confirm('Are you sure you want to delete this termination?');"
                                           title="Delete"
                                           style="background-color: #dc3545 !important; color: #ffffff !important; border: 1px solid #dc3545 !important; padding: 4px 8px; border-radius: 4px; display: inline-block;">

                                            <i class="bi bi-trash" style="color: #ffffff !important;"></i>

                                        </a>
                                        </div>
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- Add Termination Modal -->
<div class="modal fade"
     id="addTerminationModal"
     tabindex="-1"
     aria-labelledby="addTerminationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="addTerminationModalLabel">
                    Add Termination
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form asp-controller="Termination"
                  asp-action="AddTermination"
                  method="post">

                <div class="modal-body">

                    <!-- Employee -->
                    <div class="mb-3">

                        <label for="UserId"
                               class="form-label">
                            Employee
                        </label>

                        <select id="UserId"
                                name="UserId"
                                class="form-select"
                                required>

                            <option value="">Select Employee</option>

                            @if (ViewBag.Users != null)
                            {
                                @foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.UserId">
                                        @user.FirstName @user.LastName
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <!-- Termination Type -->
                    <div class="mb-3">

                        <label for="TerminationType"
                               class="form-label">
                            Termination Type
                        </label>

                        <select id="TerminationType"
                                name="TerminationType"
                                class="form-select"
                                required>

                            <option value="">Select Termination Type</option>
                            <option value="Retirement">Retirement</option>
                            <option value="Lack of Skills">Lack of Skills</option>
                            <option value="Insubordination">Insubordination</option>
                            <option value="Dismissal">Dismissal</option>
                            <option value="Layoff">Layoff</option>
                            <option value="End of Contract">End of Contract</option>

                        </select>

                    </div>

                    <!-- Notice Date -->
                    <div class="mb-3">

                        <label for="NoticeDate"
                               class="form-label">
                            Notice Date
                        </label>

                        <input type="date"
                               id="NoticeDate"
                               name="NoticeDate"
                               class="form-control"
                               required />

                    </div>

                    <!-- Termination Date -->
                    <div class="mb-3">

                        <label for="ResignDate"
                               class="form-label">
                            Termination Date
                        </label>

                        <input type="date"
                               id="ResignDate"
                               name="ResignDate"
                               class="form-control"
                               required />

                    </div>

                    <!-- Reason -->
                    <div class="mb-3">

                        <label for="Reason"
                               class="form-label">
                            Reason
                        </label>

                        <textarea id="Reason"
                                  name="Reason"
                                  class="form-control"
                                  rows="3"
                                  required
                                  maxlength="500"></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Add Termination
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- Edit Termination Modal -->
<div class="modal fade"
     id="editTerminationModal"
     tabindex="-1"
     aria-labelledby="editTerminationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="editTerminationModalLabel">
                    Edit Termination
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form asp-controller="Termination"
                  asp-action="EditTermination"
                  method="post"
                  novalidate>

                <div class="modal-body">

                    <!-- Termination Id -->
                    <input type="hidden"
                           id="editTerminationId"
                           name="TerminationId" />

                    <!-- Employee -->
                    <div class="mb-3">

                        <label for="editTerminationUserId"
                               class="form-label">
                            Employee
                        </label>

                        <select id="editTerminationUserId"
                                name="UserId"
                                class="form-select"
                                required>

                            <option value="">Select Employee</option>

                            @if (ViewBag.Users != null)
                            {
                                @foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.UserId">
                                        @user.FirstName @user.LastName
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <!-- Termination Type -->
                    <div class="mb-3">

                        <label for="editTerminationType"
                               class="form-label">
                            Termination Type
                        </label>

                        <select id="editTerminationType"
                                name="TerminationType"
                                class="form-select"
                                required>

                            <option value="">Select Termination Type</option>
                            <option value="Retirement">Retirement</option>
                            <option value="Lack of Skills">Lack of Skills</option>
                            <option value="Insubordination">Insubordination</option>
                            <option value="Dismissal">Dismissal</option>
                            <option value="Layoff">Layoff</option>
                            <option value="End of Contract">End of Contract</option>

                        </select>

                    </div>

                    <!-- Notice Date -->
                    <div class="mb-3">

                        <label for="editNoticeDate"
                               class="form-label">
                            Notice Date
                        </label>

                        <input type="date"
                               id="editNoticeDate"
                               name="NoticeDate"
                               class="form-control"
                               required />

                    </div>

                    <!-- Termination Date -->
                    <div class="mb-3">

                        <label for="editResignDate"
                               class="form-label">
                            Termination Date
                        </label>

                        <input type="date"
                               id="editResignDate"
                               name="ResignDate"
                               class="form-control"
                               required />

                    </div>

                    <!-- Reason -->
                    <div class="mb-3">

                        <label for="editReason"
                               class="form-label">
                            Reason
                        </label>

                        <textarea id="editReason"
                                  name="Reason"
                                  class="form-control"
                                  rows="3"
                                  required
                                  maxlength="500"></textarea>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Update Termination
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <!-- DataTables Core -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <!-- DataTables Buttons -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

    <!-- Excel Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <!-- PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <!-- HTML5 Export -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        $(document).ready(function() {

            var table = $('#terminationTable').DataTable({
                pageLength: 5,
                order: [[1, 'asc']],
                dom:
                    '<"row mb-3"<"col-md-6"l><"col-md-6"f>>' +
                    'rt' +
                    '<"row mt-3"<"col-md-6"i><"col-md-6"p>>',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        title: 'Termination List',
                        className: 'export-excel'
                    },
                    {
                        extend: 'pdfHtml5',
                        title: 'Termination List',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        className: 'export-pdf'
                    }
                ]
            });

            // Hide original DataTables export buttons
            $('.dt-buttons').hide();

            // Sort by Employee Name
            $('#sortFilter').on('change', function() {
                var sortValue = $(this).val();
                if (sortValue !== '') {
                    table.order([1, sortValue]).draw();
                }
            });

            // Export as Excel
            $('#exportExcel').on('click', function() {
                table.button('.export-excel').trigger();
            });

            // Export as PDF
            $('#exportPdf').on('click', function() {
                table.button('.export-pdf').trigger();
            });

            // Fill Edit Modal
            $(document).on('click', '.editTerminationButton', function() {
                var id = $(this).data('id');
                var userId = $(this).data('userid');
                var terminationType = $(this).data('terminationtype');
                var noticeDate = $(this).data('noticedate');
                var resignDate = $(this).data('resigndate');
                var reason = $(this).data('reason');

                $('#editTerminationId').val(id);
                $('#editTerminationUserId').val(userId);
                $('#editTerminationType').val(terminationType);
                $('#editNoticeDate').val(noticeDate);
                $('#editResignDate').val(resignDate);
                $('#editReason').val(reason);
            });

        });
    </script>
}
