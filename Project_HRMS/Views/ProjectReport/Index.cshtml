@model List<Project_Hrms.Models.Projects>

@{
    ViewData["Title"] = "Project Report";

    var totalProjects = Model?.Count ?? 0;
    var activeProjects = Model?.Count(x => x.Status == "Active") ?? 0;
    var completedProjects = Model?.Count(x => x.Status == "Completed") ?? 0;
    var otherProjects = totalProjects - activeProjects - completedProjects;

    var statusChart = Model?
        .GroupBy(x => x.Status)
        .Select(x => new
        {
            Status = x.Key,
            Count = x.Count()
        })
        .ToList();
}

<div class="page-wrapper">
    <div class="content">

        <!-- Page Header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="mb-1">Project Report</h4>

                <div class="d-flex align-items-center text-muted">
                    <span>Reports</span>
                    <i class="ti ti-chevron-right mx-2"></i>
                    <span>Project Report</span>
                </div>
            </div>

            <!-- Export -->
            <div class="dropdown">
                <button class="btn btn-primary dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown">
                    <i class="ti ti-download me-1"></i>
                    Export
                </button>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="#">
                            <i class="ti ti-file-type-xls me-2"></i>
                            Excel
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" href="#">
                            <i class="ti ti-file-type-pdf me-2"></i>
                            PDF
                        </a>
                    </li>
                </ul>
            </div>
        </div>


        <!-- Summary Cards + Project Status Chart -->
        <div class="row">

            <!-- LEFT SIDE - 4 CARDS -->
            <div class="col-xl-6 col-lg-6 d-flex">

                <div class="row flex-fill">

                    <!-- Total Projects -->
                    <div class="col-xl-6 col-md-6 d-flex">
                        <div class="card flex-fill">
                            <div class="card-body">

                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <p class="mb-1 text-muted">Total Projects</p>

                                        <h3 class="mb-0">
                                            @totalProjects
                                        </h3>
                                    </div>

                                    <div class="avatar avatar-lg bg-primary">
                                        <i class="ti ti-briefcase fs-24"></i>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>


                    <!-- Active Projects -->
                    <div class="col-xl-6 col-md-6 d-flex">
                        <div class="card flex-fill">
                            <div class="card-body">

                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <p class="mb-1 text-muted">Active Projects</p>

                                        <h3 class="mb-0">
                                            @activeProjects
                                        </h3>
                                    </div>

                                    <div class="avatar avatar-lg bg-success">
                                        <i class="ti ti-player-play fs-24"></i>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>


                    <!-- Completed Projects -->
                    <div class="col-xl-6 col-md-6 d-flex">
                        <div class="card flex-fill">
                            <div class="card-body">

                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <p class="mb-1 text-muted">Completed Projects</p>

                                        <h3 class="mb-0">
                                            @completedProjects
                                        </h3>
                                    </div>

                                    <div class="avatar avatar-lg bg-info">
                                        <i class="ti ti-circle-check fs-24"></i>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>


                    <!-- Other Projects -->
                    <div class="col-xl-6 col-md-6 d-flex">
                        <div class="card flex-fill">
                            <div class="card-body">

                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <p class="mb-1 text-muted">Other Status</p>

                                        <h3 class="mb-0">
                                            @otherProjects
                                        </h3>
                                    </div>

                                    <div class="avatar avatar-lg bg-warning">
                                        <i class="ti ti-clock fs-24"></i>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>

            </div>


            <!-- RIGHT SIDE - PROJECT STATUS CHART -->
            <div class="col-xl-6 col-lg-6 d-flex">

                <div class="card flex-fill">

                    <div class="card-header">
                        <div class="d-flex align-items-center justify-content-between">

                            <div>
                                <h5 class="card-title mb-1">
                                    Project Status
                                </h5>

                                <p class="text-muted mb-0">
                                    Overview of projects by status
                                </p>
                            </div>

                        </div>
                    </div>

                    <div class="card-body">

                        <div style="height: 300px;">
                            <canvas id="projectStatusChart"></canvas>
                        </div>

                    </div>

                </div>

            </div>

        </div>


<div class="card">
    <div class="card-body">

        <div class="row mb-3">

            <!-- Priority Filter -->
            <div class="col-md-4">
                <label for="priorityFilter">
                    Select Priority:
                </label>

                <select id="priorityFilter"
                        class="form-control">

                    <option value="">
                        --Select Priority--
                    </option>

                    <option value="Low">
                        Low
                    </option>

                    <option value="Medium">
                        Medium
                    </option>

                    <option value="High">
                        High
                    </option>

                </select>
            </div>


            <!-- Status Filter -->
            <div class="col-md-4">
                <label for="statusFilter">
                    Select Status:
                </label>

                <select id="statusFilter"
                        class="form-control">

                    <option value="">
                        --Select Status--
                    </option>

                    <option value="Active">
                        Active
                    </option>

                    <option value="Inactive">
                        Inactive
                    </option>

                </select>
            </div>


            <!-- Sort Filter -->
            <div class="col-md-4">
                <label for="sortOrder">
                    Sort By:
                </label>

                <select id="sortOrder"
                        class="form-control">

                    <option value="">
                        --Select--
                    </option>

                    <option value="asc">
                        Ascending
                    </option>

                    <option value="desc">
                        Descending
                    </option>

                </select>
            </div>

        </div>

    </div>
</div>

<!-- Project Table -->
<div class="card mt-3">

    <div class="card-header">
        <div>
            <h5 class="card-title mb-1">
                Project List
            </h5>

            <p class="text-muted mb-0">
                View all project details
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover"
                   id="projectTable">

                <thead>
                    <tr>
                        <th>Project ID</th>
                        <th>Project Name</th>
                        <th>Leader</th>
                        <th>Members</th>
                        <th>Deadline</th>
                        <th>Priority</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.ProjectId
                                </td>

                                <td>
                                    <strong>
                                        @item.ProjectName
                                    </strong>
                                </td>

                                <td>
                                    @item.ManagerName
                                </td>

                                <td>
                                    -
                                </td>

                                <td>
                                    @item.EndDate.ToString("dd-MM-yyyy")
                                </td>

                                <td>
                                    @if (item.Priority == "High")
                                    {
                                        <span class="project-badge high-priority">
                                            @item.Priority
                                        </span>
                                    }
                                    else if (item.Priority == "Medium")
                                    {
                                        <span class="project-badge medium-priority">
                                            @item.Priority
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="project-badge low-priority">
                                            @item.Priority
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="project-badge active-status">
                                            <i class="ti ti-point-filled me-1"></i>
                                            @item.Status
                                        </span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="project-badge completed-status">
                                            <i class="ti ti-point-filled me-1"></i>
                                            @item.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="project-badge other-status">
                                            <i class="ti ti-point-filled me-1"></i>
                                            @item.Status
                                        </span>
                                    }
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">
                                No projects found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- Custom Badge CSS -->
<style>

    .project-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 500;
    }

    /* Priority */

    .high-priority {
        background-color: #dc3545;
        color: #ffffff;
    }

    .medium-priority {
        background-color: #ffc107;
        color: #212529;
    }

    .low-priority {
        background-color: #28a745;
        color: #ffffff;
    }


    /* Status */

    .active-status {
        background-color: #28a745;
        color: #ffffff;
    }

    .completed-status {
        background-color: #0d6efd;
        color: #ffffff;
    }

    .other-status {
        background-color: #6c757d;
        color: #ffffff;
    }

    .project-badge i {
        font-size: 10px;
    }

</style>


@section Scripts {

    <!-- Project Status Chart -->

    <script>

        var statusData = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                statusChart
            )
        );

        var chartLabels = statusData.map(x => x.Status);
        var chartValues = statusData.map(x => x.Count);

        var chartElement =
            document.getElementById("projectStatusChart");

        if (chartElement) {

            new Chart(chartElement, {

                type: "pie",

                data: {

                    labels: chartLabels,

                    datasets: [
                        {
                            label: "Projects",
                            data: chartValues,
                            borderRadius: 6
                        }
                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    scales: {

                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        },

                        x: {
                            grid: {
                                display: false
                            }
                        }

                    },

                    plugins: {

                        legend: {
                            display: false
                        }

                    }

                }

            });

        }

    </script>


    <!-- DataTable -->

    <script>

$(document).ready(function () {

    var table = $("#projectTable").DataTable({

        paging: true,
        searching: true,
        ordering: true,
        info: true,

        pageLength: 10,

        lengthMenu: [
            [10, 25, 50, 100],
            [10, 25, 50, 100]
        ],

        language: {
            search: "Search:",
            lengthMenu: "_MENU_ entries",
            info: "Showing _START_ to _END_ of _TOTAL_ entries"
        }

    });


    // Priority + Status Filter
    $.fn.dataTable.ext.search.push(function (settings, data) {

        if (settings.nTable.id !== "projectTable") {
            return true;
        }

        var priority = $("#priorityFilter").val();
        var status = $("#statusFilter").val();


        // Priority column = 5
        if (priority !== "") {

            var tablePriority = $("<div>")
                .html(data[5])
                .text()
                .trim();

            if (tablePriority !== priority) {
                return false;
            }
        }


        // Status column = 6
        if (status !== "") {

            var tableStatus = $("<div>")
                .html(data[6])
                .text()
                .trim();

            if (tableStatus !== status) {
                return false;
            }
        }


        return true;

    });


    // Priority Filter
    $("#priorityFilter").on("change", function () {
        table.draw();
    });


    // Status Filter
    $("#statusFilter").on("change", function () {
        table.draw();
    });


    // Sort
    $("#sortOrder").on("change", function () {

        var sort = $(this).val();


        if (sort === "asc") {

            table
                .order([0, "asc"])
                .draw();

        }

        else if (sort === "desc") {

            table
                .order([0, "desc"])
                .draw();

        }

    });

});

    </script>

}