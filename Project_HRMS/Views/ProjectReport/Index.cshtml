@model List<Project_Hrms.Models.Projects>

@{
    ViewData["Title"] = "Project Report";

    var totalProjects = Model?.Count ?? 0;
    var activeProjects = Model?.Count(x => x.Status == "Active") ?? 0;
    var completedProjects = Model?.Count(x => x.Status == "Completed") ?? 0;
    var otherProjects = totalProjects - activeProjects - completedProjects;

    var statusChart = Model?
        .GroupBy(x => x.Status)
        .Select(x => new
        {
            Status = x.Key,
            Count = x.Count()
        })
        .ToList();
}

<div class="page-wrapper">
    <div class="content">

        <!-- Page Header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="mb-1">Project Report</h4>

                <div class="d-flex align-items-center text-muted">
                    <span>Reports</span>
                    <i class="ti ti-chevron-right mx-2"></i>
                    <span>Project Report</span>
                </div>
            </div>

            <!-- Export -->
            <div class="dropdown">
                <button class="btn btn-primary dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown">
                    <i class="ti ti-download me-1"></i>
                    Export
                </button>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="#">
                            <i class="ti ti-file-type-xls me-2"></i>
                            Excel
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" href="#">
                            <i class="ti ti-file-type-pdf me-2"></i>
                            PDF
                        </a>
                    </li>
                </ul>
            </div>
        </div>


        <!-- Summary Cards -->
        <div class="row">

            <!-- Total Projects -->
            <div class="col-xl-3 col-sm-6">
                <div class="card">
                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="mb-1 text-muted">Total Projects</p>

                                <h3 class="mb-0">
                                    @totalProjects
                                </h3>
                            </div>

                            <div class="avatar avatar-lg bg-primary">
                                <i class="ti ti-briefcase fs-24"></i>
                            </div>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Active Projects -->
            <div class="col-xl-3 col-sm-6">
                <div class="card">
                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="mb-1 text-muted">Active Projects</p>

                                <h3 class="mb-0">
                                    @activeProjects
                                </h3>
                            </div>

                            <div class="avatar avatar-lg bg-success">
                                <i class="ti ti-player-play fs-24"></i>
                            </div>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Completed Projects -->
            <div class="col-xl-3 col-sm-6">
                <div class="card">
                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="mb-1 text-muted">Completed Projects</p>

                                <h3 class="mb-0">
                                    @completedProjects
                                </h3>
                            </div>

                            <div class="avatar avatar-lg bg-info">
                                <i class="ti ti-circle-check fs-24"></i>
                            </div>
                        </div>

                    </div>
                </div>
            </div>


            <!-- Other Projects -->
            <div class="col-xl-3 col-sm-6">
                <div class="card">
                    <div class="card-body">

                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <p class="mb-1 text-muted">Other Status</p>

                                <h3 class="mb-0">
                                    @otherProjects
                                </h3>
                            </div>

                            <div class="avatar avatar-lg bg-warning">
                                <i class="ti ti-clock fs-24"></i>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>


        <!-- Project Status Chart -->
        <div class="row mt-3">

            <div class="col-xl-12">
                <div class="card">

                    <div class="card-header">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h5 class="card-title mb-1">
                                    Project Status
                                </h5>

                                <p class="text-muted mb-0">
                                    Overview of projects by status
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">

                        <div style="height: 300px;">
                            <canvas id="projectStatusChart"></canvas>
                        </div>

                    </div>

                </div>
            </div>

        </div>


        <!-- Project Table -->
        <div class="card mt-3">

            <div class="card-header">
                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <h5 class="card-title mb-1">
                            Project List
                        </h5>

                        <p class="text-muted mb-0">
                            View all project details
                        </p>
                    </div>

                    <!-- Status Filter -->
                    <div class="dropdown">

                        <button class="btn btn-light dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown">

                            <i class="ti ti-filter me-1"></i>
                            Status
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">

                            <li>
                                <a class="dropdown-item project-status-filter"
                                   href="#"
                                   data-status="">
                                    All
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item project-status-filter"
                                   href="#"
                                   data-status="Active">
                                    Active
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item project-status-filter"
                                   href="#"
                                   data-status="Completed">
                                    Completed
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item project-status-filter"
                                   href="#"
                                   data-status="Pending">
                                    Pending
                                </a>
                            </li>

                        </ul>

                    </div>

                </div>
            </div>


            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover"
                           id="projectTable">

                        <thead>
                            <tr>
                                <th>Project ID</th>
                                <th>Project Name</th>
                                <th>Leader</th>
                                <th>Members</th>
                                <th>Deadline</th>
                                <th>Priority</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <!-- Project ID -->
                                        <td>
                                            @item.ProjectId
                                        </td>


                                        <!-- Project Name -->
                                        <td>
                                            <strong>
                                                @item.ProjectName
                                            </strong>
                                        </td>


                                        <!-- Leader -->
                                        <td>
                                            @item.ManagerName
                                        </td>


                                        <!-- Members -->
                                        <td>
                                            -
                                        </td>


                                        <!-- Deadline -->
                                        <td>
                                            @item.EndDate.ToString("dd-MM-yyyy")
                                        </td>


                                        <!-- Priority -->
                                        <td>

                                            @if (item.Priority == "High")
                                            {
                                                <span class="project-badge high-priority">
                                                    @item.Priority
                                                </span>
                                            }
                                            else if (item.Priority == "Medium")
                                            {
                                                <span class="project-badge medium-priority">
                                                    @item.Priority
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="project-badge low-priority">
                                                    @item.Priority
                                                </span>
                                            }

                                        </td>


                                        <!-- Status -->
                                        <td>

                                            @if (item.Status == "Active")
                                            {
                                                <span class="project-badge active-status">
                                                    <i class="ti ti-point-filled me-1"></i>
                                                    @item.Status
                                                </span>
                                            }
                                            else if (item.Status == "Completed")
                                            {
                                                <span class="project-badge completed-status">
                                                    <i class="ti ti-point-filled me-1"></i>
                                                    @item.Status
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="project-badge other-status">
                                                    <i class="ti ti-point-filled me-1"></i>
                                                    @item.Status
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7"
                                        class="text-center">
                                        No projects found.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
</div>


<!-- Custom Badge CSS -->
<style>

    .project-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 500;
    }

    /* Priority */

    .high-priority {
        background-color: #dc3545;
        color: #ffffff;
    }

    .medium-priority {
        background-color: #ffc107;
        color: #212529;
    }

    .low-priority {
        background-color: #28a745;
        color: #ffffff;
    }


    /* Status */

    .active-status {
        background-color: #28a745;
        color: #ffffff;
    }

    .completed-status {
        background-color: #0d6efd;
        color: #ffffff;
    }

    .other-status {
        background-color: #6c757d;
        color: #ffffff;
    }

    .project-badge i {
        font-size: 10px;
    }

</style>


@section Scripts {

    <!-- Project Status Chart -->

    <script>

        var statusData = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                statusChart
            )
        );

        var chartLabels = statusData.map(x => x.Status);
        var chartValues = statusData.map(x => x.Count);

        var chartElement =
            document.getElementById("projectStatusChart");

        if (chartElement) {

            new Chart(chartElement, {

                type: "bar",

                data: {

                    labels: chartLabels,

                    datasets: [
                        {
                            label: "Projects",
                            data: chartValues,
                            borderRadius: 6
                        }
                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    scales: {

                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        },

                        x: {
                            grid: {
                                display: false
                            }
                        }

                    },

                    plugins: {

                        legend: {
                            display: false
                        }

                    }

                }

            });

        }

    </script>


    <!-- DataTable -->

    <script>

        $(document).ready(function () {

            if ($.fn.DataTable.isDataTable("#projectTable")) {
                $("#projectTable").DataTable().destroy();
            }

            $("#projectTable").DataTable({

                paging: true,

                searching: true,

                ordering: true,

                info: true,

                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                language: {

                    search: "Search:",

                    lengthMenu: "_MENU_ entries",

                    info: "Showing _START_ to _END_ of _TOTAL_ entries"

                }

            });


            // Status Filter

            $(".project-status-filter").on("click", function (e) {

                e.preventDefault();

                var status =
                    $(this).data("status");

                var table =
                    $("#projectTable").DataTable();

                if (status === "") {

                    table
                        .column(6)
                        .search("")
                        .draw();

                }
                else {

                    table
                        .column(6)
                        .search(
                            "^" + status + "$",
                            true,
                            false
                        )
                        .draw();

                }

            });

        });

    </script>

}
