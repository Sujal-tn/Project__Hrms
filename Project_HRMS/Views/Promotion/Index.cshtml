@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<Project_Hrms.Models.PromotionViewModels>

@{
    ViewData["Title"] = "Promotion";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Promotions</h2>

        <button type="button"
                class="btn"
                style="background-color: #F26522; color: white;"
                data-bs-toggle="modal"
                data-bs-target="#addPromotionModal">
            Add Promotion
        </button>
    </div>

    <!-- Promotion Card -->
    <div class="card">

        <!-- Card Header -->
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

            <h5 class="mb-0">Promotion List</h5>

            <div class="d-flex align-items-center gap-2 flex-wrap">

                <!-- Sorting Filter -->
                <select id="sortFilter"
                        class="form-select"
                        style="width: 150px;">

                    <option value="">Sort By</option>
                    <option value="asc">Employee A-Z</option>
                    <option value="desc">Employee Z-A</option>
                </select>

                <!-- Export Dropdown -->
                <div class="dropdown">

                    <button type="button"
                            class="btn dropdown-toggle"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Export
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportPdf">
                                Export as PDF
                            </button>
                        </li>

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportExcel">
                                Export as Excel
                            </button>
                        </li>

                    </ul>

                </div>

            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body">

            <div class="table-responsive">

                <table id="promotionTable"
                       class="table table-bordered table-hover align-middle w-100">

                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Employee Name</th>
                            <th>Designation From</th>
                            <th>Designation To</th>
                            <th>Promotion Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.PromotionId</td>

                                <td>@item.EmployeeName</td>

                                <td>@item.DesignationFrom</td>

                                <td>@item.DesignationTo</td>

                                <td>@item.PromotionDate</td>

                                <td>

                                    <!-- Edit Button -->
                                    <button type="button"
                                            class="btn btn-sm editPromotionButton"
                                            data-id="@item.PromotionId"
                                            data-userid="@item.UserId"
                                            data-designationfrom="@item.DesignationFrom"
                                            data-designationto="@item.DesignationTo"
                                            data-date="@item.Date.ToString("yyyy-MM-dd")"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editPromotionModal"
                                            title="Edit">

                                        <i class="bi bi-pencil-square"></i>

                                    </button>


                                    <!-- Delete Button -->
                                    <a asp-controller="Promotion"
                                       asp-action="DeletePromotion"
                                       asp-route-id="@item.PromotionId"
                                       class="btn btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this promotion?');"
                                       title="Delete">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- Add Promotion Modal -->
<div class="modal fade"
     id="addPromotionModal"
     tabindex="-1"
     aria-labelledby="addPromotionModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="addPromotionModalLabel">
                    Add Promotion
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form asp-controller="Promotion"
                  asp-action="AddPromotion"
                  method="post">

                <div class="modal-body">

                    <!-- Employee -->
                    <div class="mb-3">

                        <label for="UserId"
                               class="form-label">
                            Employee
                        </label>

                        <select id="UserId"
                                name="UserId"
                                class="form-select"
                                required>

                            <option value="">Select Employee</option>

                            @foreach (var user in ViewBag.Users)
                            {
                                <option value="@user.UserId">
                                    @user.FirstName @user.LastName
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Designation From -->
                    <div class="mb-3">

                        <label for="DesignationFrom"
                               class="form-label">
                            Current Designation
                        </label>

                        <select id="DesignationFrom"
                                name="DesignationFrom"
                                class="form-select"
                                required>

                            <option value="">Select Current Designation</option>

                            @foreach (var designation in ViewBag.Designations)
                            {
                                <option value="@designation.Name">
                                    @designation.Name
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Designation To -->
                    <div class="mb-3">

                        <label for="DesignationTo"
                               class="form-label">
                            Promotion Designation
                        </label>

                        <select id="DesignationTo"
                                name="DesignationTo"
                                class="form-select"
                                required>

                            <option value="">Select Promotion Designation</option>

                            @foreach (var designation in ViewBag.Designations)
                            {
                                <option value="@designation.Name">
                                    @designation.Name
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Promotion Date -->
                    <div class="mb-3">

                        <label for="Date"
                               class="form-label">
                            Promotion Date
                        </label>

                        <input type="date"
                               id="Date"
                               name="Date"
                               class="form-control"
                               required />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Add Promotion
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- Edit Promotion Modal -->
<div class="modal fade"
     id="editPromotionModal"
     tabindex="-1"
     aria-labelledby="editPromotionModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="editPromotionModalLabel">
                    Edit Promotion
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form asp-controller="Promotion"
                  asp-action="EditPromotion"
                  method="post"
                  novalidate>

                <div class="modal-body">

                    <!-- Promotion Id -->
                    <input type="hidden"
                           id="editPromotionId"
                           name="PromotionId" />


                    <!-- Employee -->
                    <div class="mb-3">

                        <label for="editPromotionUserId"
                               class="form-label">
                            Employee
                        </label>

                        <select id="editPromotionUserId"
                                name="UserId"
                                class="form-select"
                                required>

                            <option value="">Select Employee</option>

                            @foreach (var user in ViewBag.Users)
                            {
                                <option value="@user.UserId">
                                    @user.FirstName @user.LastName
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Designation From -->
                    <div class="mb-3">

                        <label for="editPromotionDesignationFrom"
                               class="form-label">
                            Current Designation
                        </label>

                        <select id="editPromotionDesignationFrom"
                                name="DesignationFrom"
                                class="form-select"
                                required>

                            <option value="">Select Current Designation</option>

                            @foreach (var designation in ViewBag.Designations)
                            {
                                <option value="@designation.Name">
                                    @designation.Name
                                </option>
                            }

                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("DesignationFrom")
                        </span>

                    </div>


                    <!-- Designation To -->
                    <div class="mb-3">

                        <label for="editPromotionDesignationTo"
                               class="form-label">
                            Promotion Designation
                        </label>

                        <select id="editPromotionDesignationTo"
                                name="DesignationTo"
                                class="form-select"
                                required>

                            <option value="">Select Promotion Designation</option>

                            @foreach (var designation in ViewBag.Designations)
                            {
                                <option value="@designation.Name">
                                    @designation.Name
                                </option>
                            }

                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("DesignationTo")
                        </span>

                    </div>


                    <!-- Promotion Date -->
                    <div class="mb-3">

                        <label for="editPromotionDate"
                               class="form-label">
                            Promotion Date
                        </label>

                        <input type="date"
                               id="editPromotionDate"
                               name="Date"
                               class="form-control"
                               required />

                        <span class="text-danger">
                            @Html.ValidationMessage("Date")
                        </span>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Update Promotion
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <!-- DataTables Core -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <!-- DataTables Buttons -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

    <!-- Excel Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <!-- PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <!-- HTML5 Export -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>


    <script>

        $(document).ready(function() {

            var table = $('#promotionTable').DataTable({

                pageLength: 5,

                order: [[1, 'asc']],

                dom:
                    '<"row mb-3"<"col-md-6"l><"col-md-6"f>>' +
                    'rt' +
                    '<"row mt-3"<"col-md-6"i><"col-md-6"p>>',

                buttons: [

                    {
                        extend: 'excelHtml5',
                        title: 'Promotion List',
                        className: 'export-excel'
                    },

                    {
                        extend: 'pdfHtml5',
                        title: 'Promotion List',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        className: 'export-pdf'
                    }

                ]

            });


            // Hide original DataTables export buttons
            $('.dt-buttons').hide();


            // Sort by Employee Name
            $('#sortFilter').on('change', function() {

                var sortValue = $(this).val();

                if (sortValue !== '') {

                    table
                        .order([1, sortValue])
                        .draw();

                }

            });


            // Export as Excel
            $('#exportExcel').on('click', function() {

                table
                    .button('.export-excel')
                    .trigger();

            });


            // Export as PDF
            $('#exportPdf').on('click', function() {

                table
                    .button('.export-pdf')
                    .trigger();

            });


            // Fill Edit Modal
            $('.editPromotionButton').on('click', function() {

                var id = $(this).data('id');
                var userId = $(this).data('userid');
                var designationFrom = $(this).data('designationfrom');
                var designationTo = $(this).data('designationto');
                var date = $(this).data('date');


                $('#editPromotionId').val(id);

                $('#editPromotionUserId').val(userId);

                $('#editPromotionDesignationFrom')
                    .val(designationFrom);

                $('#editPromotionDesignationTo')
                    .val(designationTo);

                $('#editPromotionDate')
                    .val(date);

            });

        });

    </script>

}