
@model List<Project_Hrms.Models.EmployeeModel.User>

@{
    ViewData["Title"] = "Employee Report";
}

<div class="container-fluid">

    <h2 class="mb-4">Employee Report</h2>

    <!-- Top Section -->
    <div class="row">

        <!-- Cards -->
        <div class="col-md-6">

            <div class="row">

                <div class="col-6 mb-3">
                    <div class="card text-center p-3">
                        <h5>
                            <i class="bi bi-person-circle text-danger"></i>
                            Total Users
                        </h5>
                        <p>@ViewBag.TUser</p>
                    </div>
                </div>

                <div class="col-6 mb-3">
                    <div class="card text-center p-3">
                        <h5>
                            <i class="bi bi-person-check text-danger"></i>
                            Active Users
                        </h5>
                        <p>@ViewBag.AUser</p>
                    </div>
                </div>

                <div class="col-6 mb-3">
                    <div class="card text-center p-3">
                        <h5>
                            <i class="bi bi-person-x text-danger"></i>
                            Inactive Users
                        </h5>
                        <p>@ViewBag.InUser</p>
                    </div>
                </div>

                <div class="col-6 mb-3">
                    <div class="card text-center p-3">
                        <h5>
                            <i class="bi bi-briefcase text-danger"></i>
                            Roles
                        </h5>
                        <p>@ViewBag.Rcount</p>
                    </div>
                </div>

            </div>
        </div>


        <!-- Chart -->
        <div class="col-md-6">

            <h5>
                <i class="bi bi-bar-chart-fill text-danger"></i>
                Employee
            </h5>

            <canvas id="employeeStatusChart"></canvas>

        </div>

    </div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

        <h5 class="mb-0">Employees List</h5>

        <div class="d-flex align-items-center gap-2">

            <select class="form-select form-select-sm"
                    id="statusFilter"
                    style="width: 150px;">

                <option value="">All</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>

            </select>

            <select class="form-select form-select-sm"
                    id="sortFilter"
                    style="width: 170px;">

                <option value="recent">Recently Added</option>
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
                <option value="lastMonth">Last Month</option>
                <option value="last7Days">Last 7 Days</option>

            </select>

        </div>

    </div>
</div>


    <!-- Employee Table -->
    <div class="card mt-4">

        <div class="card-body">

            <h5 class="card-title mb-3">
                Employees List
            </h5>

            <div class="table-responsive">

                <table id="employeeTable" class="table table-bordered table-hover">

                    <thead class="table-light">
                        <tr>
                            <th>UserId</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Phone Number</th>
                            <th>Date of Joining</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <td>@user.UserId</td>

                                <td>
                                    @user.FirstName @user.LastName
                                </td>

                                <td>@user.Email</td>

                                <td>@user.Department?.DepartmentName</td>

                                <td>@user.PhoneNumber</td>

                                <td>@user.DateOfJoining</td>

                                <td>

                                    @if (user.Status == "Active")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        var data = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(ViewBag.YearData)
        );

        var labels = data.map(x => x.Year + '-' + x.Month);
        var active = data.map(x => x.Active);
        var inactive = data.map(x => x.Inactive);

        new Chart(document.getElementById('employeeStatusChart'), {

            type: 'bar',

            data: {
                labels: labels,

                datasets: [
                    {
                        label: 'Active',
                        data: active
                    },
                    {
                        label: 'Inactive',
                        data: inactive
                    }
                ]
            }

        });

var table = $('#employeeTable').DataTable();


// Status Filter
$.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

    // Only apply this filter to employeeTable
    if (settings.nTable.id !== 'employeeTable') {
        return true;
    }

    var selectedStatus = $('#statusFilter').val();

    // All selected
    if (selectedStatus === '') {
        return true;
    }

    // Status column = column 6
    var tableStatus = $('<div>').html(data[6]).text().trim();

    // Exact comparison
    return tableStatus === selectedStatus;
});


$('#statusFilter').on('change', function () {

    table.draw();

});




        $('#sortFilter').on('change', function () {

            var sort = $(this).val();

            if (sort === 'asc') {

                table.order([0, 'asc']).draw();

            }
            else if (sort === 'desc') {

                table.order([0, 'desc']).draw();

            }
            else if (sort === 'recent') {

                table.order([5, 'desc']).draw();

            }
            else if (sort === 'lastMonth') {


            }
            else if (sort === 'last7Days') {

            

            }

        });

    </script>

}