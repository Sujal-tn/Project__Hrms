    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List< Project_Hrms.Models.Organization>
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Organizations List</h4>
            <p class="text-muted mb-0">Organizations</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addOrganizationModal">
            <i class="ti ti-plus me-1"></i>
            Add Organization
        </button>
</div>
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Organizations List</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Organization Name</th>
                            <th>Address</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Logo</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
@foreach (var organization in Model)
                        { 
                        <tr>
                                <td>
                                    <strong>
                                        @organization.OrganizationName
                                    </strong>
                                </td>
                                <td>
                                    @(organization.OrganizationAddress ?? "Nil")
                                </td>
                                <td>
                                    @(organization.OrganizationPhone ?? "Nil")
                                </td>
                                <td>
                                    @(organization.OrganizationEmail ?? "Nil")
                                </td>
                                <td>
                                    <img src="~/@organization.OrganizationLogo"
                                         alt="Organization Logo"
                                         style="width:80px;height:40px;object-fit:contain;" />
                                </td>
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-light"
                                            asp-action="UpdateOrganization"
                                            asp-route-id="@organization.OrganizationId">
                                        <i class="ti ti-edit"></i>
                                    </button>

                                    <form asp-controller="Organization"
                                              asp-action="DeleteOrganization"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this organization?');">
                                        <input type="hidden"
                                               name="id"
                                               value="@organization.OrganizationId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-light text-danger">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div></div></div></div>
<div class="modal fade" id="addOrganizationModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Organization</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Organization" asp-action="AddOrganization" method="post">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Organization Name</label>
                            <input name="OrganizationName" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Phone</label>
                            <input name="OrganizationPhone" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <input name="OrganizationEmail" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Address</label>
                            <input name="OrganizationAddress" class="form-control" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Description</label>
                            <textarea name="OrganizationDescription" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Logo</label>
                            <input name="OrganizationLogo" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

                        }