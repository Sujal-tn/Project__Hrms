@model Project_Hrms.Models.Organization

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Update Organization</h4>
            <p class="text-muted mb-0">Update organization information</p>
        </div>
        <a asp-controller="Organization"
           asp-action="Index"
           class="btn btn-light">
            <i class="ti ti-arrow-left me-1"></i>
            Back
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Organization Information</h5>
        </div>

        <div class="card-body">
            <form asp-controller="Organization"
                  asp-action="UpdateOrganization"
                  method="post">

                <input type="hidden" asp-for="OrganizationId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="OrganizationName" class="form-label">Organization Name</label>
                        <input asp-for="OrganizationName" class="form-control" />
                        <span asp-validation-for="OrganizationName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="OrganizationPhone" class="form-label">Phone</label>
                        <input asp-for="OrganizationPhone" class="form-control" />
                        <span asp-validation-for="OrganizationPhone" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="OrganizationEmail" class="form-label">Email</label>
                        <input asp-for="OrganizationEmail" class="form-control" />
                        <span asp-validation-for="OrganizationEmail" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="OrganizationAddress" class="form-label">Address</label>
                        <input asp-for="OrganizationAddress" class="form-control" />
                        <span asp-validation-for="OrganizationAddress" class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="OrganizationDescription" class="form-label">Description</label>
                        <textarea asp-for="OrganizationDescription"
                                  class="form-control"
                                  rows="4"></textarea>
                        <span asp-validation-for="OrganizationDescription" class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="OrganizationLogo" class="form-label">Logo</label>
                        <input asp-for="OrganizationLogo" class="form-control" />
                        <span asp-validation-for="OrganizationLogo" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Organization"
                       asp-action="Index"
                       class="btn btn-light">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i>
                        Update Organization
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}