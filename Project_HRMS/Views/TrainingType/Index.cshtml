@model List<TrainingType>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Training Type</h2>
        </div>

        <a asp-controller="TrainingType" asp-action="AddType" class="btn btn-primary"> Add Training Type </a>
    </div>


    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5>Training Type List</h5>

            <select id="sortTrainingType" class="form-select w-auto">
                <option value="recent">Recently Added</option>
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
            </select>

        </div>

        <div class="card-body">

            <table class="table table-bordered">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="trainingTypeTable">

                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>@d.TrainingTypeId</td>
                            <td>@d.TrainingTypeName</td>
                            <td>@d.Description</td>

                            <td>
                                @if (d.Status == "Active")
                                {
                                    <span class="badge bg-success"> Active </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="TrainingType" asp-action="EditType" class="btn btn-sm btn-warning" asp-route-id="@d.TrainingTypeId">
                                    Edit
                                </a>

                                <a asp-controller="TrainingType" asp-action="DeleteType" class="btn btn-sm btn-danger" onclick="return confirm('Do you want to delete this record ?')" asp-route-id="@d.TrainingTypeId">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>



@section Scripts
{
    <script>
        $('#sortTrainingType').change(function() {

            var value = $(this).val();
            var table = $('table').DataTable();

            if (value == "recent") {
                table.order([0, 'desc']).draw();
            }
            else if (value == "asc") {
                table.order([0, 'asc']).draw();
            }
            else if (value == "desc") {
                table.order([0, 'desc']).draw();
            }

        });
    </script>
}