
@model List<Project_Hrms.Models.EmployeeModel.Department>
@if (TempData["msg"] != null)
{
    <alert class="text-bg-success">@TempData["msg"]</alert>
}

@if (TempData["DelMsg"] != null)
{
    <alert class="text-bg-danger"> @TempData["DelMsg"]</alert>
}
<a asp-controller="Department" asp-action="AddDepartment" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#addDepartmentModal"> <i class="fa fa-plus"></i> Add Department</a>

<br>
<table class="table">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Department</th>
            <th scope="auto">NO-Of-Employes </th>
            <th scope="col">CreatedBy</th>
            <th scope="col">ModifiedBy</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.DepartmentId</td>
                <td>@r.DepartmentName</td>
                <td>@r.NoOfEmployee</td>
                <td>@r.CreatedBy</td>
                <td>@r.ModifiedBy</td>
                <td>
                    @if (r.Status == "Active")
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            InActive
                        </span>
                    }
                </td>

                <td>
                    <a asp-controller="Department" asp-action="EditDepartment" asp-route-id="@r.DepartmentId" class="btn btn-primary">Edit</a>
                    <a asp-controller="Department" asp-action="DeleteDepartment" asp-route-id="@r.DepartmentId" class="btn btn-Delete" onclick="return confirm('Are you Sure Want to Delete this Department')">Delete</a>

                </td>

            </tr>

        }
    </tbody>
</table>


@* 
//Add Modal *@
<div class="modal fade" id="addDepartmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Add DepartmentS
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal">
                </button>
            </div>
            <div class="modal-body">
                <form asp-controller="Department" asp-action="AddDepartment" method="post">
                    <div class="mb-3">
                        <label class="form-label">
                             Name
                        </label>
                        <input type="text" name="DepartmentName" class="form-control" placeholder="Enter Department Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            Status
                        </label>
                        <select name="Status" class="form-control">
                            <option value="Active">
                                Active
                            </option>
                            <option value="InActive">
                                InActive
                            </option>
                        </select>
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">
                            Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

