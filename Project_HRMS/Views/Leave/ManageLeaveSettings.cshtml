@model List<Project_Hrms.Models.MasterLeaveType>

@{
    ViewBag.Title = "Manage Leave Settings";
}

<h2 class="mb-4">@ViewBag.Title</h2>

@if (TempData["success"] != null)
{
    <div class="alert alert-success">@TempData["success"]</div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger">@TempData["error"]</div>
}

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-xl-4 col-md-6">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="form-check form-check-md form-switch me-1">
                            <form method="post" asp-action="UpdateLeaveTypeStatus">
                                <input type="hidden" name="leaveTypeId" value="@item.LeaveTypeId" />
                                <input type="hidden" name="status" value="@(item.Status == "Active" ? "Inactive" : "Active")" />
                                <input type="checkbox" class="form-check-input" onchange="this.form.submit()"
                                       @(item.Status == "Active" ? "checked" : "") />
                            </form>
                        </div>
                        <h6 class="d-flex align-items-center">@item.LeaveType</h6>
                    </div>
                </div>
            </div>
        </div>
    }
</div>