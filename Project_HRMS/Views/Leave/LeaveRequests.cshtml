@model List<Project_Hrms.Models.LeaveRequest>
@{
    var leaveBalances = ViewBag.LeaveBalances as List<Project_Hrms.Models.LeaveBalance>;
    var leaveTypes = ViewBag.LeaveTypes as List<Project_Hrms.Models.DepartmentLeaves>;
}

<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
    <div class="my-auto mb-2">
        <h2 class="mb-1">Leave Requests</h2>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="index.html"><i class="ti ti-smart-home"></i></a></li>
                <li class="breadcrumb-item">Employee</li>
                <li class="breadcrumb-item active" aria-current="page">Leave Requests</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex my-xl-auto right-content align-items-center flex-wrap">
        <div class="mb-2">
            <a id="applyLeaveButton" class="btn btn-primary d-flex align-items-center">
                <i class="ti ti-circle-plus me-2"></i>Apply Leave
            </a>
        </div>
    </div>
</div>

@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" asp-action="ApplyLeave" id="applyLeaveForm" style="display:none;" class="card p-3 mb-3">
    <div class="form-group mb-2">
        <label for="leaveTypeId">Leave Type</label>
        <select class="form-control" id="leaveTypeId" name="leaveTypeId" required>
            <option value="">Select Leave Type</option>
            @if (leaveTypes != null)
            {
                @foreach (var dl in leaveTypes)
                {
                    <option value="@dl.LeaveTypeId">@dl.MasterLeaveType.LeaveType</option>
                }
            }
        </select>
    </div>
    <div class="row">
        <div class="form-group col-md-6 mb-2">
            <label for="startDate">Start Date</label>
            <input type="date" class="form-control" id="startDate" name="startDate" required />
        </div>
        <div class="form-group col-md-6 mb-2">
            <label for="endDate">End Date</label>
            <input type="date" class="form-control" id="endDate" name="endDate" required />
        </div>
    </div>
    <div class="form-group mb-2">
        <label for="reason">Reason</label>
        <textarea class="form-control" id="reason" name="reason" rows="2" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Submit</button>
</form>

<div class="row">
    @if (leaveBalances != null)
    {
        @foreach (var balance in leaveBalances)
        {
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <p class="mb-1">@balance.MasterLeaveType.LeaveType</p>
                            <h3 class="mb-2">@balance.TotalLeaves</h3>
                            <span class="badge bg-info-transparent">Remaining Leaves : @balance.RemainingLeaves</span>
                        </div>
                        <span class="avatar avatar-lg bg-primary rounded-circle">
                            <i class="ti ti-calendar-event fs-20"></i>
                        </span>
                    </div>
                </div>
            </div>
        }
    }
</div>

<div class="card mt-3">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
        <h5 class="mb-0">My Leave Requests</h5>
    </div>
    <div class="card-body">
        <table class="table" id="leaveRequestTable">
            <thead class="thead-light">
                <tr>
                    <th>Leave ID</th>
                    <th>Leave Type</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Reason</th>
                    <th>No of Days</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>@request.LeaveRequestId</td>
                            <td>@request.MasterLeaveType.LeaveType</td>
                            <td>@request.StartDate.ToString("dd-MM-yyyy")</td>
                            <td>@request.EndDate.ToString("dd-MM-yyyy")</td>
                            <td>@request.Reason</td>
                            <td>@request.NumberOfDays</td>
                            <td>
                                @if (request.Status == "Approved")
                                {
                                    <span class="badge bg-success">@request.Status</span>
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">@request.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@request.Status</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#applyLeaveButton").click(function () {
                $("#applyLeaveForm").toggle();
            });

            $('#leaveRequestTable').DataTable({
                pageLength: 5,
                lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "All"]]
            });
        });
    </script>
}