@{
    ViewData["Title"] = "Earning Type";
    ViewData["PayrollActive"] = "Earning";
}

<div class="payroll-top">
	<partial name="_PayrollMasterTabs" />

	<a href="#" id="openearntypemodal" data-bs-target="#earning_type" data-bs-toggle="modal" class="btn-payroll text-decoration-none">
		<i class="ti ti-circle-plus me-2"></i>Add Earning Type
	</a>
</div>

<div class="card-body p-0">
	<div class="table-responsive">
		<table class="table payroll-table">
			<thead>
				<tr>
					<th>Id</th>
					<th>Earning Type Name</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody id="earningtypedata">
			</tbody>
		</table>
	</div>
</div>

<!-- Add Earning Type -->
<div class="modal fade payroll-modal" id="earning_type" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered modal-md">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title">Add Earning Type</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form method="post" id="earningtypeform">
					<label class="form-label">Earning Type Name</label>
					<input type="text" class="form-control" placeholder="Enter Earning Type Name" name="EarningName" />
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-light border me-2" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn-payroll" id="addearntypebtn">Add Earning Type</button>
			</div>
		</div>
	</div>
</div>

<!-- Edit Earning Type -->
<div class="modal fade payroll-modal" id="editearningtype" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered modal-md">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title">Edit Earning Type</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form method="post" id="editearningtypeform">
					<input type="hidden" name="EarntypeId" id="editEarntypeId" />
					<label class="form-label">Earning Type Name</label>
					<input type="text" class="form-control" name="EarningName" id="editEarningName" />
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-light border me-2" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn-payroll" id="editearntypebtn">Update Earning Type</button>
			</div>
		</div>
	</div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/earningtypejavascript.js"></script>
