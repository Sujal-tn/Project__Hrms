    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<Project_Hrms.Models.EmployeeModel.Designation>
@if (TempData["msg"]!=null)
{
    <alert class="text-bg-success">@TempData["msg"]</alert>
}

@if (TempData["DelMsg"] != null)
{
    <alert class="text-bg-danger"> @TempData["DelMsg"]</alert>
}
<a asp-controller="Designation" asp-action="AddDesignation" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#addRoleModal"> <i class="fa fa-plus"></i>Add Designation</a>

<br />

<table class="table">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">DesignationName</th>
            <th scope="col">DepartmentName</th>
            <th scope="col">NoOfEmployee</th>
            <th scope="col">Status</th>
            <th scope="col">CreatedBy</th>
            <th scope="col">ModifiedBy</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.DesignationId</td>
                <td>@r.DesignationName</td>
                <td>@r.Department.DepartmentName</td>
                <td>@r.Department.NoOfEmployee</td>
                <td>
                    @if (r.Status == "Active")
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            InActive
                        </span>
                    }
                </td>
                <td>@r.CreatedBy</td>
                <td>@r.ModifiedBy</td>
                <td>
                    <a asp-controller="Designation" asp-action="EditDesignation" asp-route-id="@r.DesignationId" class="btn btn-primary">Edit</a>
                    <a asp-controller="Designation" asp-action="DeleteDesignation" asp-route-id="@r.DesignationId" class="btn btn-Delete" onclick="return confirm('Are you Sure Want to Delete this Role?')">Delete</a>

                </td>

            </tr>
        }
    </tbody>
</table>

@* 
//Add Modal *@
<div class="modal fade" id="addRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Add Designations
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal">
                </button>
            </div>
            <div class="modal-body">
                <form asp-controller="Designation" asp-action="AddDesignation" method="post">
                    <div class="mb-3">
                        <label class="form-label">
                            Designation Name
                        </label>
                        <input type="text" name="DesignationName" class="form-control" placeholder="Enter Designation Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                           DepartmentName
                        </label>
                      
                        <select name="DepartmentId" class="form-control">
                             <option value="">-- Select Department --</option>

                 @foreach (var d in ViewBag.Departments)
                       {
                           <option value="@d.DepartmentId">
                                  @d.DepartmentName
                              </option>
                       }

                            
                        </select>
                        
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            Status
                        </label>
                        <select name="Status" class="form-control">
                            <option value="Active">
                                Active
                            </option>
                            <option value="InActive">
                                InActive
                            </option>
                        </select>
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">
                            Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>