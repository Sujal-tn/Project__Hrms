@model IEnumerable<Project_Hrms.Models.Tasks>

<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">

    <div class="my-auto mb-2">

        <h2 class="mb-1">Tasks</h2>

        <nav>
            <ol class="breadcrumb mb-0">

                <li class="breadcrumb-item">

                    <a href="index.html">
                        <i class="ti ti-smart-home"></i>
                    </a>

                </li>

                <li class="breadcrumb-item">
                    Employee
                </li>

                <li class="breadcrumb-item active" aria-current="page">
                    Tasks
                </li>

            </ol>
        </nav>

    </div>


    <div class="d-flex my-xl-auto right-content align-items-center flex-wrap">

        <div class="mb-2">

            <a asp-controller="Tasks"
               asp-action="AddTask"
               class="btn btn-primary d-flex align-items-center">

                <i class="ti ti-circle-plus me-2"></i>
                Add Task

            </a>

        </div>


        <div class="head-icons ms-2">

            <a href="javascript:void(0);"
               data-bs-toggle="tooltip"
               data-bs-placement="top"
               data-bs-original-title="Collapse"
               id="collapse-header">

                <i class="ti ti-chevrons-up"></i>

            </a>

        </div>

    </div>

</div>


<div class="container-fluid">

    <!-- Filters -->

    <div class="row">

        <div class="col-xl-8">

            <div class="row">

                <!-- Priority -->

                <div class="col-lg-5">

                    <div class="d-flex align-items-center flex-wrap row-gap-3 mb-3">

                        <h6 class="me-2">
                            Priority
                        </h6>


                        <ul class="nav nav-pills border d-inline-flex p-1 rounded bg-light todo-tabs">

                            <li class="nav-item">

                                <button type="button"
                                        class="nav-link filter-btn @(ViewBag.SelectedPriority == null || ViewBag.SelectedPriority == "All" ? "active" : "")"
                                        data-priority="All">

                                    All

                                </button>

                            </li>


                            <li class="nav-item">

                                <button type="button"
                                        class="nav-link filter-btn @(ViewBag.SelectedPriority == "High" ? "active" : "")"
                                        data-priority="High">

                                    High

                                </button>

                            </li>


                            <li class="nav-item">

                                <button type="button"
                                        class="nav-link filter-btn @(ViewBag.SelectedPriority == "Medium" ? "active" : "")"
                                        data-priority="Medium">

                                    Medium

                                </button>

                            </li>


                            <li class="nav-item">

                                <button type="button"
                                        class="nav-link filter-btn @(ViewBag.SelectedPriority == "Low" ? "active" : "")"
                                        data-priority="Low">

                                    Low

                                </button>

                            </li>

                        </ul>

                    </div>

                </div>


                <!-- Due Date -->

                <div class="col-lg-7">

                    <div class="d-flex align-items-center justify-content-lg-end flex-wrap row-gap-3 mb-3">

                        <div class="input-icon w-120 position-relative me-2">

                            <span class="input-icon-addon">

                                <i class="ti ti-calendar"></i>

                            </span>


                            <input type="date"
                                   class="form-control"
                                   id="DueDateFilter"
                                   value="@ViewBag.SelectedDueDate">

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Main Content -->

    <div class="row">


        <!-- Left Side - Project Cards -->

        <div class="col-xl-4"
             style="height: 100vh; overflow-y: auto;">

            @{
                var projectIds = new List<int>();
            }


            @foreach (var task in Model)
            {

                if (!projectIds.Contains(task.ProjectId))
                {
                    projectIds.Add(task.ProjectId);


                    <div class="card mb-3 task-card"
                         data-priority="@task.Priority"
                         data-duedate="@task.Deadline.ToString("yyyy-MM-dd")">

                        <div class="card-body">


                            <!-- Project Header -->

                            <div class="d-flex align-items-center pb-3 mb-3 border-bottom">

                                <a class="flex-shrink-0 me-2">

                                    @if (!string.IsNullOrEmpty(task.Projects?.LogoPath))
                                    {

                                        <img src="@task.Projects.LogoPath"
                                             alt="Project Logo"
                                             style="width: 50px;
                                                    height: 50px;
                                                    object-fit: cover;">

                                    }

                                </a>


                                <div>

                                    <h6 class="mb-1">

                                        <a>
                                            @task.Projects?.ProjectName
                                        </a>

                                    </h6>


                                    <div class="d-flex align-items-center">

                                        <span>

                                            @Model.Count(x => x.ProjectId == task.ProjectId)
                                            tasks

                                        </span>


                                        <span class="mx-1">

                                            <i class="ti ti-point-filled text-primary"></i>

                                        </span>


                                        <span>

                                            @Model.Count(x => x.ProjectId == task.ProjectId && x.Status == "Completed")
                                            Completed

                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- Deadline and Value -->

                            <div class="row">

                                <div class="col-sm-6">

                                    <div class="mb-3">

                                        <span class="mb-1 d-block">
                                            Deadline
                                        </span>


                                        <p class="fw-medium mb-0">

                                            Due on:

                                            <span class="text-gray-9">

                                                @task.Deadline.ToString("dd MMM yyyy")

                                            </span>

                                        </p>

                                    </div>

                                </div>


                                <div class="col-sm-6">

                                    <div class="mb-3">

                                        <span class="mb-1 d-block">
                                            Value
                                        </span>


                                        <p class="text-dark">

                                            $@task.Projects?.ProjectValue

                                        </p>

                                    </div>

                                </div>

                            </div>


                            <!-- Task Progress -->

                            <div class="bg-light p-2">

                                <div class="d-flex justify-content-between mb-2">

                                    <span class="fw-medium">
                                        Tasks Done
                                    </span>


                                    <span>

                                        @Model.Count(x => x.ProjectId == task.ProjectId && x.Status == "Completed")

                                        /

                                        @Model.Count(x => x.ProjectId == task.ProjectId)

                                    </span>

                                </div>


                                <div class="progress"
                                     style="height: 6px;">

                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="width: @(Model.Count(x => x.ProjectId == task.ProjectId) == 0 ? 0 : (Model.Count(x => x.ProjectId == task.ProjectId && x.Status == "Completed") * 100 / Model.Count(x => x.ProjectId == task.ProjectId)))%;">

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            }

        </div>


        <!-- Right Side - Task Details -->

        <div class="col-xl-8"
             style="height: 100vh; overflow-y: auto;">

            <div class="card">

                <div class="card-body">


                    <!-- Project Information -->

                    @foreach (var task in Model)
                    {

                        <h4 class="mb-2">

                            @task.Projects?.ProjectName

                        </h4>


                        <p class="text-muted mb-3">

                            @task.Projects?.ProjectDescription

                        </p>

                        break;

                    }


                    <!-- Task Progress -->

                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <span class="fw-medium">
                            Tasks Done
                        </span>


                        @foreach (var task in Model)
                        {

                            <span>

                                @Model.Count(x => x.ProjectId == task.ProjectId && x.Status == "Completed")

                                /

                                @Model.Count(x => x.ProjectId == task.ProjectId)

                            </span>

                            break;

                        }

                    </div>


                    @foreach (var task in Model)
                    {

                        <div class="progress mb-4"
                             style="height: 6px;">

                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: @(Model.Count(x => x.ProjectId == task.ProjectId) == 0 ? 0 : (Model.Count(x => x.ProjectId == task.ProjectId && x.Status == "Completed") * 100 / Model.Count(x => x.ProjectId == task.ProjectId)))%;">

                            </div>

                        </div>

                        break;

                    }


                    <!-- Task Details -->

                    <div class="list-group list-group-flush mb-4">

                        @foreach (var task in Model)
                        {

                            <div class="list-group-item list-item-hover shadow-sm rounded mb-2 p-3">

                                <div class="row align-items-center row-gap-3">


                                    <!-- Task Information -->

                                    <div class="col-lg-6 col-md-7">

                                        <div class="todo-inbox-check d-flex align-items-center flex-wrap row-gap-3">


                                            <!-- Drag Icon -->

                                            <span class="me-2 d-flex align-items-center">

                                                <i class="ti ti-grid-dots text-dark"></i>

                                            </span>


                                            <!-- Star Icon -->

                                            <span class="me-2 d-flex align-items-center rating-select">

                                                <i class="ti ti-star-filled filled"></i>

                                            </span>


                                            <!-- Task Title -->

                                            <div class="strike-info">

                                                <h4 class="fs-14 text-truncate">

                                                    @task.Title

                                                </h4>

                                            </div>


                                            <!-- Deadline -->

                                            <span class="badge bg-transparent-dark text-dark rounded-pill ms-2">

                                                <i class="ti ti-calendar me-1"></i>

                                                @task.Deadline.ToString("dd MMM yyyy")

                                            </span>

                                        </div>

                                    </div>


                                    <!-- Priority and Status -->

                                    <div class="col-lg-6 col-md-5">

                                        <div class="d-flex align-items-center justify-content-md-end flex-wrap row-gap-3">


                                            <!-- Priority -->

                                            <span class="badge badge-skyblue me-3">

                                                @task.Priority

                                            </span>


                                            <!-- Status -->

                                            <span class="badge bg-soft-pink d-inline-flex align-items-center me-3">

                                                <i class="fas fa-circle fs-6 me-1"></i>

                                                @task.Status

                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        }

                    </div>


                </div>

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {


        // Priority Filter

        var buttons = document.querySelectorAll(".filter-btn");


        buttons.forEach(function (button) {

            button.addEventListener("click", function () {

                var priority =
                    button.getAttribute("data-priority");


                var dueDate =
                    document.getElementById("DueDateFilter").value;


                var url =
                    "/Tasks/Index?priority=" +
                    encodeURIComponent(priority);


                if (dueDate) {

                    url +=
                        "&dueDate=" +
                        encodeURIComponent(dueDate);

                }


                window.location.href = url;

            });

        });


        // Due Date Filter

        document.getElementById("DueDateFilter").addEventListener("change", function () {


            var activeButton =
                document.querySelector(".filter-btn.active");


            var priority = "All";


            if (activeButton) {

                priority =
                    activeButton.getAttribute("data-priority");

            }


            var dueDate =
                this.value;


            var url =
                "/Tasks/Index?priority=" +
                encodeURIComponent(priority);


            if (dueDate) {

                url +=
                    "&dueDate=" +
                    encodeURIComponent(dueDate);

            }


            window.location.href = url;

        });

    });

</script>