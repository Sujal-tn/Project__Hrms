@model List<Project_Hrms.Models.LeaveRequest>

@{
    ViewData["Title"] = "Leave Requests";
}

<div class="container-fluid mt-4">

    <h2 class="mb-4">Leave Report</h2>

    <!-- Top Section -->
    <div class="row">

        <!-- Cards -->
       <!-- Cards -->
<div class="col-md-6">

    <div class="row">

        <!-- Total Leaves -->
        <div class="col-6 mb-3">
            <div class="card text-center p-3">
                <h5>
                    <i class="bi bi-calendar-check text-danger"></i>
                    Total Leaves
                </h5>
                <p>@ViewBag.TotalLeaves</p>
            </div>
        </div>

        <!-- Approved Leaves -->
        <div class="col-6 mb-3">
            <div class="card text-center p-3">
                <h5>
                    <i class="bi bi-check-circle text-success"></i>
                    Approved Leaves
                </h5>
                <p>@ViewBag.ApprovedLeaves</p>
            </div>
        </div>

        <!-- Pending Requests -->
        <div class="col-6 mb-3">
            <div class="card text-center p-3">
                <h5>
                    <i class="bi bi-hourglass-split text-warning"></i>
                    Pending Requests
                </h5>
                <p>@ViewBag.PendingRequests</p>
            </div>
        </div>

        <!-- Rejected Leaves -->
        <div class="col-6 mb-3">
            <div class="card text-center p-3">
                <h5>
                    <i class="bi bi-x-circle text-danger"></i>
                    Rejected Leaves
                </h5>
                <p>@ViewBag.RejectedLeaves</p>
            </div>
        </div>

    </div>
</div>


        <!-- Chart -->
        <div class="col-md-6">

            <h5>
                <i class="bi bi-bar-chart-fill text-danger"></i>
                Leaves
            </h5>

            <canvas id="LeaveChart"></canvas>

        </div>

    </div>

<div class="card">
    <div class="row mb-3">

        <div class="col-md-4">
            <label for="dateFilter">Select Date Filter:</label>

            <select id="dateFilter" class="form-control">
                <option value="">All</option>
                <option value="yesterday">Yesterday</option>
                <option value="last7days">Last 7 Days</option>
                <option value="last30days">Last 30 Days</option>
                <option value="lastYear">Last Year</option>
                <option value="thisYear">This Year</option>
            </select>
        </div>

        <div class="col-md-4">
            <label for="statusFilter">Select Status Filter:</label>

            <select id="statusFilter" class="form-control">
                <option value="">All</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>

        <div class="col-md-4">
            <label for="sortOrder">Sort By:</label>

            <select id="sortOrder" class="form-control">
                <option value="">--Select--</option>
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
                <option value="last7days">Last 7 Days</option>
                <option value="lastMonth">Last Month</option>
            </select>
        </div>

    </div>
</div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Leave Requests</h4>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table id="leaveTable"
                       class="table table-striped table-hover table-bordered align-middle">

                    <thead class="table">
                        <tr>
                            <th>ID</th>
                            <th>User ID</th>
                            <th>Leave Type</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Days</th>
                            <th>Reason</th>
                            <th>Approved By</th>
                            <th>Status</th>
                            <th>Status History</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var leave in Model)
                        {
                            <tr>
                                <td>@leave.LeaveRequestId</td>
                                <td>@leave.User?.FirstName @leave.User?.LastName</td>
                                <td>@leave.MasterLeaveType?.LeaveType</td>
                                <td data-date="@leave.StartDate.ToString("yyyy-MM-dd")">
                                    @leave.StartDate.ToString("dd-MM-yyyy")
                                </td>
                                <td>@leave.EndDate</td>
                                <td>@leave.NumberOfDays</td>
                                <td>@leave.Reason</td>
                                <td>@leave.ApprovedBy</td>

                                <td>
                                    @if (leave.Status == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else if (leave.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else if (leave.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @leave.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    @leave.StatusHistory
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>
  @section Scripts {


     @* Chart  *@
    <script>

    var data = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(ViewBag.MonthlyPaidLeave)
    );

    var labels = data.map(x => x.Month);
    var paidLeave = data.map(x => x.Days);

    new Chart(document.getElementById('LeaveChart'), {

        type: 'bar',

        data: {
            labels: labels,

            datasets: [
                {
                    label: 'Paid Leave',
                    data: paidLeave
                }
            ]
        },

        options: {
            responsive: true
        }

    });

var table = $('#leaveTable').DataTable();

$.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

    if (settings.nTable.id !== 'leaveTable') {
        return true;
    }

    var selectedStatus = $('#statusFilter').val();
    var selectedDate = $('#dateFilter').val();
    var selectedSort = $('#sortOrder').val();

   
    if (selectedStatus !== '') {

        // Status column = 8
        var status = $('<div>')
            .html(data[8])
            .text()
            .trim();

        if (status !== selectedStatus) {
            return false;
        }
    }


    // -------------------------
    // DATE
    // -------------------------

    // Start Date column = 3
    var startDateText = $('<div>')
        .html(data[3])
        .text()
        .trim();

    var startDate = new Date(startDateText);

    if (isNaN(startDate.getTime())) {
        return false;
    }

    startDate.setHours(0, 0, 0, 0);


    var today = new Date();
    today.setHours(0, 0, 0, 0);


    // -------------------------
    // DATE FILTER
    // -------------------------

    if (selectedDate === 'yesterday') {

        var yesterday = new Date(today);

        yesterday.setDate(today.getDate() - 1);

        if (startDate.getTime() !== yesterday.getTime()) {
            return false;
        }
    }


    if (selectedDate === 'last7days') {

        var sevenDaysAgo = new Date(today);

        sevenDaysAgo.setDate(today.getDate() - 7);

        if (startDate < sevenDaysAgo ||
            startDate > today) {

            return false;
        }
    }


    if (selectedDate === 'last30days') {

        var thirtyDaysAgo = new Date(today);

        thirtyDaysAgo.setDate(today.getDate() - 30);

        if (startDate < thirtyDaysAgo ||
            startDate > today) {

            return false;
        }
    }


    if (selectedDate === 'lastYear') {

        var lastYear = today.getFullYear() - 1;

        if (startDate.getFullYear() !== lastYear) {
            return false;
        }
    }


    if (selectedDate === 'thisYear') {

        if (startDate.getFullYear() !== today.getFullYear()) {
            return false;
        }
    }


    // -------------------------
    // SORT FILTER - LAST 7 DAYS
    // -------------------------

    if (selectedSort === 'last7days') {

        var sevenDaysAgoSort = new Date(today);

        sevenDaysAgoSort.setDate(today.getDate() - 7);

        if (startDate < sevenDaysAgoSort ||
            startDate > today) {

            return false;
        }
    }



    if (selectedSort === 'lastMonth') {

        var firstDayLastMonth = new Date(
            today.getFullYear(),
            today.getMonth() - 1,
            1
        );

        var lastDayLastMonth = new Date(
            today.getFullYear(),
            today.getMonth(),
            0
        );

        if (startDate < firstDayLastMonth ||
            startDate > lastDayLastMonth) {

            return false;
        }
    }


    return true;
});


$('#statusFilter').on('change', function () {

    table.draw();

});


$('#dateFilter').on('change', function () {

    table.draw();

});



$('#sortOrder').on('change', function () {

    var sort = $(this).val();


    if (sort === 'asc') {

        // ID ascending
        table.order([0, 'asc']).draw();

    }

    else if (sort === 'desc') {

        // ID descending
        table.order([0, 'desc']).draw();

    }

    else if (sort === 'last7days') {

        table.draw();

    }

    else if (sort === 'lastMonth') {

        table.draw();

    }

});


</script>

}
