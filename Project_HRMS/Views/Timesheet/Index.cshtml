@model List<Project_Hrms.Models.Timesheet>
@using Microsoft.AspNetCore.Mvc.Rendering

<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
    <div class="my-auto mb-2">
        <h2 class="mb-1">Timesheets</h2>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="index.html"><i class="ti ti-smart-home"></i></a></li>
                <li class="breadcrumb-item">Employee</li>
                <li class="breadcrumb-item active" aria-current="page">Timesheet</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex my-xl-auto right-content align-items-center flex-wrap">
        <div class="mb-2">
            <a id="addTimesheetButton" class="btn btn-primary d-flex align-items-center">
                <i class="ti ti-circle-plus me-2"></i>Add Timesheet
            </a>
        </div>
    </div>
</div>

@if (TempData["success"] != null)
{
    <div class="alert alert-success">@TempData["success"]</div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger">@TempData["error"]</div>
}

<div class="mb-3">
    <a asp-action="Index" asp-route-filter="All" class="btn @(ViewBag.Filter == "All" ? "btn-primary" : "btn-outline-primary")">All</a>
    <a asp-action="Index" asp-route-filter="Weekly" class="btn @(ViewBag.Filter == "Weekly" ? "btn-primary" : "btn-outline-primary")">Weekly</a>
    <a asp-action="Index" asp-route-filter="Monthly" class="btn @(ViewBag.Filter == "Monthly" ? "btn-primary" : "btn-outline-primary")">Monthly</a>
</div>

<form method="post" asp-action="AddTimesheet" id="addTimesheetForm" style="display:none;" class="card p-3 mb-3">
    <div class="row">
        <div class="form-group col-md-4 mb-2">
            <label for="projectId">Project</label>
            <select class="form-control" id="projectId" name="projectId" required>
                <option value="">Select Project</option>
                @foreach (var project in ViewBag.Projects as SelectList)
                {
                    <option value="@project.Value">@project.Text</option>
                }
            </select>
        </div>
        <div class="form-group col-md-4 mb-2">
            <label for="date">Date</label>
            <input type="date" class="form-control" id="date" name="date" required />
        </div>
        <div class="form-group col-md-4 mb-2">
            <label for="workHours">Worked Hours</label>
            <input type="number" min="0" class="form-control" id="workHours" name="workHours" required />
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Submit</button>
</form>

<form method="post" asp-action="SendForApproval" id="approvalForm">
    <input type="hidden" name="timesheetIds" id="timesheetIds" />

    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
            <h5 class="mb-0">Timesheet</h5>
            <button type="submit" class="btn btn-outline-primary">Send for Approval</button>
        </div>
        <div class="card-body">
            <table class="table" id="timesheetTable">
                <thead class="thead-light">
                    <tr>
                        <th><input type="checkbox" id="selectAll" /></th>
                        <th>Project</th>
                        <th>Date</th>
                        <th>Worked Hours</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td>
                                    @if (t.Status == "Pending")
                                    {
                                        <input type="checkbox" class="rowCheck" value="@t.TimesheetId" />
                                    }
                                </td>
                                <td>@t.Projects.ProjectName</td>
                                <td>@t.Date.ToString("dd-MM-yyyy")</td>
                                <td>@t.WorkHours</td>
                                <td>
                                    @if (t.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">@t.Status</span>
                                    }
                                    else if (t.Status == "Pending Approval")
                                    {
                                        <span class="badge bg-info">@t.Status</span>
                                    }
                                    else if (t.Status == "Approved")
                                    {
                                        <span class="badge bg-success">@t.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@t.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</form>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#addTimesheetButton").click(function () {
                $("#addTimesheetForm").toggle();
            });

            $('#timesheetTable').DataTable({
                pageLength: 5,
                lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "All"]]
            });

            $("#selectAll").change(function () {
                $(".rowCheck").prop("checked", $(this).is(":checked"));
            });

            $("#approvalForm").submit(function () {
                var ids = $(".rowCheck:checked").map(function () { return this.value; }).get();
                $("#timesheetIds").val(ids.join(","));
            });
        });
    </script>
}