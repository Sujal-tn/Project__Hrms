@model List<Project_Hrms.Models.Attendance>
@{
    var today = (Project_Hrms.Models.Attendance?)ViewBag.TodayAttendance;
    var employee = (Project_Hrms.Models.EmployeeModel.User?)ViewBag.Employee;
}

<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
    <div class="my-auto mb-2">
        <h2 class="mb-1">Employee Attendance</h2>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="index.html"><i class="ti ti-smart-home"></i></a></li>
                <li class="breadcrumb-item">Employee</li>
                <li class="breadcrumb-item active" aria-current="page">Attendance</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex my-xl-auto right-content align-items-center flex-wrap">
        <div class="dropdown mb-2 me-2">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="ti ti-file-export me-1"></i>Export
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#">Export as PDF</a></li>
                <li><a class="dropdown-item" href="#">Export as Excel</a></li>
            </ul>
        </div>
        <div class="mb-2">
            <a href="#" class="btn btn-primary d-flex align-items-center">
                <i class="ti ti-report me-2"></i>Report
            </a>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <p class="mb-1">Good Morning, @(employee != null ? $"{employee.FirstName} {employee.LastName}" : "Employee")</p>
                <p class="text-muted mb-2">@DateTime.Now.ToString("hh:mm tt, dd MMM yyyy")</p>

                @if (!string.IsNullOrEmpty(employee?.ProfilePicture))
                {
                    <img src="@employee.ProfilePicture" class="rounded-circle mb-2" width="70" height="70" alt="profile" />
                }
                else
                {
                    <span class="avatar avatar-xl rounded-circle bg-primary-transparent mb-2 d-inline-flex align-items-center justify-content-center">
                        <i class="ti ti-user fs-24"></i>
                    </span>
                }

                <div class="mb-2">
                    <span class="badge bg-primary-transparent">Production : @((today?.ProductionHours ?? 0))h</span>
                </div>

                <p class="mb-2">
                    <i class="ti ti-broadcast"></i>
                    Punch In at: @(today?.CheckIn?.ToString("hh:mm tt") ?? "Not Checked In")
                </p>

                <form method="post" asp-action="MarkAttendance">
                    <button type="submit" class="btn btn-primary">@ViewBag.AttendanceStatus</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <span class="avatar avatar-md bg-warning-transparent rounded mb-2">
                    <i class="ti ti-clock-hour-4 fs-18"></i>
                </span>
                <h4>@ViewBag.TotalToday</h4>
                <p class="mb-1">Total Hours Today</p>
                <span class="text-success"><i class="ti ti-arrow-up"></i> Today</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <span class="avatar avatar-md bg-dark-transparent rounded mb-2">
                    <i class="ti ti-clock-hour-9 fs-18"></i>
                </span>
                <h4>@ViewBag.TotalWeek</h4>
                <p class="mb-1">Total Hours Week</p>
                <span class="text-success"><i class="ti ti-arrow-up"></i> Last Week</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <span class="avatar avatar-md bg-pink-transparent rounded mb-2">
                    <i class="ti ti-calendar-stats fs-18"></i>
                </span>
                <h4>@ViewBag.OvertimeMonth</h4>
                <p class="mb-1">Overtime This Month</p>
                <span class="text-danger"><i class="ti ti-arrow-down"></i> Last Month</span>
            </div>
        </div>
    </div>
</div>

@{
    var working = today?.WorkingHours ?? 0;
    var productive = today?.ProductionHours ?? 0;
    var breakHrs = today?.BreakHours ?? 0;
    var overtime = today?.OvertimeHours ?? 0;
    var scale = Math.Max(working + breakHrs + overtime, 1);
}
<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-4 mb-3">
            <span><i class="ti ti-point-filled text-secondary"></i> Total Working hours <strong>@(working)h</strong></span>
            <span><i class="ti ti-point-filled text-success"></i> Productive Hours <strong>@(productive)h</strong></span>
            <span><i class="ti ti-point-filled text-warning"></i> Break hours <strong>@(breakHrs)h</strong></span>
            <span><i class="ti ti-point-filled text-primary"></i> Overtime <strong>@(overtime)h</strong></span>
        </div>
        <div class="progress" style="height: 10px;">
            <div class="progress-bar bg-success" style="width:@((productive / scale) * 100)%"></div>
            <div class="progress-bar bg-warning" style="width:@((breakHrs / scale) * 100)%"></div>
            <div class="progress-bar bg-primary" style="width:@((overtime / scale) * 100)%"></div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Employee Attendance</h5>
    </div>
    <div class="card-body">
    <form method="get" asp-action="FilterAttendance" id="filterForm" class="row g-2 mb-3 align-items-center">
        <div class="col-md-2">
            <label class="me-1">Start:</label>
            <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
        </div>
        <div class="col-md-2">
            <label class="me-1">End:</label>
            <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-control">
                <option value="All">Select Status</option>
                <option value="Present">Present</option>
                <option value="Half Day">Half Day</option>
                <option value="Absent">Absent</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="sortBy" class="form-control">
                <option value="recent">Recently Added</option>
                <option value="asc">Oldest First</option>
                <option value="last7Days">Last 7 Days</option>
                <option value="lastMonth">Last Month</option>
            </select>
        </div>
</form>

        <table class="table" id="attendanceTable">
            <thead class="thead-light">
                <tr>
                    <th>Date</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                    <th>Working Hours</th>
                    <th>Break Hours</th>
                    <th>Overtime</th>
                    <th>Late (min)</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.Date.ToString("dd-MM-yyyy")</td>
                            <td>@(a.CheckIn?.ToString("hh:mm tt") ?? "-")</td>
                            <td>@(a.CheckOut?.ToString("hh:mm tt") ?? "-")</td>
                            <td>@a.WorkingHours</td>
                            <td>@a.BreakHours</td>
                            <td>@a.OvertimeHours</td>
                            <td>@a.Late</td>
                            <td>
                                @if (a.Status == "Present")
                                {
                                    <span class="badge bg-success">@a.Status</span>
                                }
                                else if (a.Status == "Absent")
                                {
                                    <span class="badge bg-danger">@a.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@a.Status</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#attendanceTable').DataTable({
                pageLength: 10,
                lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "All"]],
                language: {
                    emptyTable: "No attendance records found for the selected filters."
                }
            });

            $("#filterForm input, #filterForm select").on("change", function () {
                $("#filterForm").submit();
            });
        });
    </script>
}