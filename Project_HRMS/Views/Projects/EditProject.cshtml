@model Project_Hrms.Models.Projects

<h2>Edit Project</h2>

<form asp-action="EditProject" asp-controller="Projects" asp-route-id="@Model.ProjectId" method="post">

    <input type="hidden" asp-for="ProjectId" />

    <div class="mb-3">
        <label asp-for="ProjectName" class="form-label">Project Name</label>
        <input asp-for="ProjectName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ClientName" class="form-label">Client Name</label>
        <input asp-for="ClientName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ProjectDescription" class="form-label">Description</label>
        <textarea asp-for="ProjectDescription" class="form-control" rows="4"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label">Start Date</label>
        <input asp-for="StartDate" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label asp-for="EndDate" class="form-label">End Date</label>
        <input asp-for="EndDate" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label asp-for="Priority" class="form-label">Priority</label>

        <select asp-for="Priority" class="form-select">
            <option value="">Select Priority</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
            <option value="Low">Low</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="PriceType" class="form-label">Currency Type</label>

        <select asp-for="PriceType" class="form-select">
            <option value="">Select Currency Type</option>
            <option value="USD">USD</option>
            <option value="INR">INR</option>
            <option value="EUR">EUR</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label">Status</label>

        <select asp-for="Status" class="form-select">
            <option value="">Select Status</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="ManagerName" class="form-label">Project Manager Name</label>
        <input asp-for="ManagerName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Logo (Optional)</label>
        <input type="file" name="logo" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">File (Optional)</label>
        <input type="file" name="file" class="form-control" />
    </div>

    <div class="mb-3">
        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>
    </div>

</form>