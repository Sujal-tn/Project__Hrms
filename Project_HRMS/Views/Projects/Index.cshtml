@model List<Projects>

@if (TempData["addmsg"] != null)
{
    <span class="text-success">@TempData["addmsg"]</span>
}

@if (TempData["updmsg"] != null)
{
    <span class="text-success">@TempData["updmsg"]</span>
}

@if (TempData["delmsg"] != null)
{
    <span class="text-success">@TempData["delmsg"]</span>
}

<div>
    <div>
        <h2 class="mb-1">Projects</h2>
        <div class="text-muted"> Home / Employee / Projects List </div>
    </div>

    <a asp-controller="Projects" asp-action="AddProject" class="btn btn-primary"> Add Project</a>
</div>

<table class="table table-bordered" id="projectTable">

    <thead>
        <tr>
            <th>Project Id</th>
            <th>Project Name</th>
            <th>Team Members</th>
            <th>Client</th>
            <th>Deadline</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProjectId</td>
                <td>@p.ProjectName</td>
                <td>@p.ManagerName</td>
                <td>@p.ClientName</td>
                <td>@p.EndDate.ToString("dd MMM yyyy")</td>
                <td>@p.Priority</td>
                <td>@p.Status</td>
                <td>
                    <a asp-controller="Projects" asp-action="EditProject" asp-route-id="@p.ProjectId" class="btn btn-success">Edit</a>
                    <a asp-controller="Projects" asp-action="DeleteProject" asp-route-id="@p.ProjectId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>

</table>
