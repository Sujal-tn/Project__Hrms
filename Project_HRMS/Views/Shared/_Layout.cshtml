```cshtml
@using Microsoft.AspNetCore.Http

@{
    var userName = Context.Session.GetString("Name");
    var userEmail = Context.Session.GetString("Email");
    var roleName = Context.Session.GetString("RoleName");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Project_Hrms</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Project_Hrms.styles.css" asp-append-version="true" />

    <style>
            html,
            body {
                min-height: 100%;
                margin: 0;
            }

            body {
                overflow-x: hidden;
            }

            .admin-layout {
                min-height: 100vh;
                display: flex;
            }

            .admin-sidebar {
                flex: 0 0 300px;
                height: 100vh;
                overflow-y: auto;
                overflow-x: hidden;
            }

            .admin-content {
                min-width: 0;
                min-height: 100vh;
                flex: 1;
                display: flex;
                flex-direction: column;
            }

                .admin-content main {
                    flex: 1;
                    width: 100%;
                    min-width: 0;
                }

            .admin-footer {
                width: 100%;
                margin-top: auto;
            }

            .sidebar-link,
            .submenu a {
                text-decoration: none;
            }

            .profile-avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #0d6efd;
                color: #fff;
                font-weight: 600;
                font-size: 16px;
            }

            .profile-name {
                line-height: 18px;
            }
    </style>
</head>

<body>

    <header class="header">
        <div class="main-header">

            <div class="header-left">
                <a href="#" class="logo">
                    <img src="~/assets/img/Logo_Pulse360 (2).png" alt="Logo">
                </a>

                <a href="#" class="dark-logo">
                    <img src="~/assets/img/Logo_Pulse360 (2).png" alt="Logo">
                </a>
            </div>

            <a id="mobile_btn" class="mobile_btn" href="#sidebar">
                <span class="bar-icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
            </a>

            <div class="header-user">
                <div class="nav user-menu nav-list w-100">

                    <div class="me-auto d-flex align-items-center" id="header-search">

                        <a id="toggle_btn"
                           href="javascript:void(0);"
                           class="btn btn-menubar me-1">
                            <i class="ti ti-arrow-bar-to-left"></i>
                        </a>

                        <div class="input-group input-group-flat d-inline-flex me-1">
                            <span class="input-icon-addon">
                                <i class="ti ti-search"></i>
                            </span>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Search in Pulse360">

                            <span class="input-group-text">
                                <kbd>CTRL + /</kbd>
                            </span>
                        </div>

                        <a href="#" class="btn btn-menubar me-1">
                            <i class="ti ti-layout-grid"></i>
                        </a>

                        <a href="#" class="btn btn-menubar">
                            <i class="ti ti-settings-cog"></i>
                        </a>

                    </div>

                    <div class="dropdown ms-3">

                        <a href="#"
                           class="d-flex align-items-center text-decoration-none dropdown-toggle"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            <div class="me-2 text-end profile-name">
                                <div class="fw-semibold">
                                    @(string.IsNullOrEmpty(userName) ? "User" : userName)
                                </div>

                                <small class="text-muted">
                                    @(string.IsNullOrEmpty(roleName) ? "Employee" : roleName)
                                </small>
                            </div>

                            <div class="profile-avatar">
                                @if (!string.IsNullOrEmpty(userName))
                                {
                                    @userName.Substring(0, 1).ToUpper()
                                }
                                else
                                {
                                    <span>U</span>
                                }
                            </div>

                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <li>
                                <div class="px-3 py-2">
                                    <div class="fw-semibold">
                                        @(string.IsNullOrEmpty(userName) ? "User" : userName)
                                    </div>

                                    <small class="text-muted">
                                        @userEmail
                                    </small>

                                    <div>
                                        <span class="badge bg-primary mt-1">
                                            @roleName
                                        </span>
                                    </div>
                                </div>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Emp"
                                   asp-action="EmpDetails">
                                    <i class="ti ti-user me-2"></i>
                                    My Profile
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="#">
                                    <i class="ti ti-settings me-2"></i>
                                    Settings
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="Auth"
                                   asp-action="Logout">
                                    <i class="ti ti-logout me-2"></i>
                                    Logout
                                </a>
                            </li>

                        </ul>

                    </div>

                </div>
            </div>

        </div>
    </header>

    <div class="admin-layout">

        <aside class="admin-sidebar" id="sidebar">

            <div class="sidebar-logo">
                <h2>HRMS</h2>
            </div>

            <p class="sidebar-title">MAIN MENU</p>

            <nav class="sidebar-menu">

                @if (roleName == "Admin")
                {
                    <details>
                        <summary class="sidebar-link">
                            <span>⌂</span>
                            Dashboard
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a asp-controller="Auth" asp-action="AdminD">
                                Admin Dashboard
                            </a>

                            <a asp-controller="Organization" asp-action="Index">
                                Organization
                            </a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <span>♙</span>
                            Employees
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a asp-controller="Department" asp-action="Index">
                                Add Department
                            </a>

                            <a asp-controller="Role" asp-action="Index">
                                Add Role
                            </a>

                            <a asp-controller="Designation" asp-action="Index">
                                Add Designation
                            </a>

                            <a asp-controller="Emp" asp-action="Index">
                                Employee List
                            </a>

                            <a asp-controller="Emp" asp-action="EmpGrid">
                                Employee Grid
                            </a>

                            <a asp-controller="Emp" asp-action="EmpDetails">
                                Employee Details
                            </a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <span>▣</span>
                            Events
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a asp-controller="Events" asp-action="Index">
                                Events
                            </a>

                            <a asp-controller="Event" asp-action="index11">
                                Add Event
                            </a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <span>✎</span>
                            Training
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a href="#">Training List</a>
                            <a href="#">Add Training</a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <span>▱</span>
                            Performance & Goal
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a href="#">Performance List</a>
                            <a href="#">Add Goal</a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <span>♧</span>
                            Attendance
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a asp-controller="Leave" asp-action="AddLeaveType">
                                Add Leave Type
                            </a>

                            <a asp-controller="Leave" asp-action="AddLeaveDeptwise">
                                Add Leave
                            </a>

                            <a asp-controller="Leave" asp-action="DepartmentLeaveDetails">
                                Department Leave Details
                            </a>

                            <a asp-controller="Leave" asp-action="ManageLeaveSettings">
                                Leave Setting
                            </a>

                            <a asp-controller="AdminAttendance" asp-action="Index">
                                Attendance
                            </a>

                            <a asp-controller="AdminTimesheet" asp-action="Index">
                                Timesheet
                            </a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <span>▣</span>
                            Payroll
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a asp-controller="EmpSalaries" asp-action="AddEmployeeSalary">
                                Add Employee Salary
                            </a>

                            <a asp-controller="Earning" asp-action="Earning">
                                Master Payroll
                            </a>

                            <a asp-controller="EmpSalaries" asp-action="EmployeeSalary">
                                Employee Salary List
                            </a>

                            <a asp-controller="Payslip"
                               asp-action="GeneratePayslipsForAllUsersByDate">
                                Generate Monthly Payslip
                            </a>

                            <a asp-controller="Payslip"
                               asp-action="TransactionHistory">
                                Transaction History
                            </a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <span>▱</span>
                            Reports
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a asp-controller="EmployeeReport" asp-action="Index">
                                Employee Report
                            </a>

                            <a asp-controller="AttendanceReport" asp-action="Index">
                                Attendance Report
                            </a>

                            <a asp-controller="LeaveReport" asp-action="Index">
                                Leave Report
                            </a>

                            <a asp-controller="ProjectReport" asp-action="Index">
                                Project Report
                            </a>

                            <a asp-controller="TaskReport" asp-action="Index">
                                Task Report
                            </a>

                            <a asp-controller="DailyReport" asp-action="Index">
                                Daily Report
                            </a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <span>▱</span>
                            Documents
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a href="#">All Documents</a>
                            <a href="#">Upload Document</a>
                        </div>
                    </details>

                    <a asp-controller="Promotion"
                       asp-action="Index"
                       class="sidebar-link">
                        <span>⬆</span>
                        Promotion
                    </a>

                    <a asp-controller="Resignation"
                       asp-action="Index"
                       class="sidebar-link">
                        <span>✉</span>
                        Resignation
                    </a>

                    <a asp-controller="Termination"
                       asp-action="Index"
                       class="sidebar-link">
                        <span>✖</span>
                        Termination
                    </a>
                }

                @if (roleName == "Manager")
                {
                    <details>
                        <summary class="sidebar-link">
                            <span>♙</span>
                            Employees
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a asp-controller="Emp" asp-action="EmpGrid">
                                Team Employees
                            </a>

                            <a asp-controller="Emp" asp-action="EmpDetails">
                                Employee Details
                            </a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <span>▣</span>
                            Projects
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a href="#">Project List</a>
                            <a href="#">Add Project</a>
                            <a href="#">Project Details</a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <span>♧</span>
                            Attendance
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a asp-controller="AdminAttendance"
                               asp-action="Index">
                                Team Attendance
                            </a>

                            <a asp-controller="AdminTimesheet"
                               asp-action="Index">
                                Team Timesheet
                            </a>

                            <a asp-controller="Leave"
                               asp-action="DepartmentLeaveDetails">
                                Team Leave
                            </a>
                        </div>
                    </details>

                    <a href="#" class="sidebar-link">
                        <span>▱</span>
                        Performance
                    </a>

                    <a href="#" class="sidebar-link">
                        <span>▱</span>
                        Reports
                    </a>

                    <a href="#" class="sidebar-link">
                        <span>▱</span>
                        Training
                    </a>
                }

                @if (roleName == "Employee")
                {
                    <a asp-controller="Auth"
                       asp-action="EmpD"
                       class="sidebar-link">
                        <i class="ti ti-layout-dashboard"></i>
                        <span>Dashboard</span>
                    </a>

                    <a asp-controller="Emp"
                       asp-action="EmpDetails"
                       class="sidebar-link">
                        <i class="ti ti-user"></i>
                        <span>My Profile</span>
                    </a>

                    <details>
                        <summary class="sidebar-link">
                            <i class="ti ti-users"></i>
                            <span>Employees</span>
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a asp-controller="Emp" asp-action="EmpDetails">
                                My Profile
                            </a>

                            <a href="#">Employee Details</a>
                            <a href="#">My Team</a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <i class="ti ti-calendar-check"></i>
                            <span>Attendance</span>
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a href="#">My Attendance</a>
                            <a href="#">Attendance Details</a>
                            <a href="#">Attendance History</a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <i class="ti ti-wallet"></i>
                            <span>Payroll</span>
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a href="#">My Payroll</a>
                            <a href="#">Payslips</a>
                            <a href="#">Salary Details</a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <i class="ti ti-calendar"></i>
                            <span>Calendar</span>
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a href="#">My Calendar</a>
                            <a href="#">Events</a>
                            <a href="#">Holidays</a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <i class="ti ti-chart-bar"></i>
                            <span>Performance</span>
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a href="#">My Performance</a>
                            <a href="#">Goals</a>
                            <a href="#">Appraisal</a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <i class="ti ti-file-description"></i>
                            <span>Documents</span>
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a href="#">My Documents</a>
                            <a href="#">Company Documents</a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <i class="ti ti-headset"></i>
                            <span>Help & Support</span>
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a href="#">Help Center</a>
                            <a href="#">Support</a>
                        </div>
                    </details>

                    <details>
                        <summary class="sidebar-link">
                            <i class="ti ti-ticket"></i>
                            <span>Tickets</span>
                            <span class="menu-arrow">⌃</span>
                        </summary>

                        <div class="submenu">
                            <a asp-controller="Ticket"
                               asp-action="Index">
                                My Tickets
                            </a>

                            <a href="#">
                                Create Ticket
                            </a>
                        </div>
                    </details>
                }

                <a asp-controller="Ticket"
                   asp-action="Index"
                   class="sidebar-link">
                    <span>🎫</span>
                    Tickets
                </a>

                <a asp-controller="Auth"
                   asp-action="Logout"
                   class="sidebar-link logout-link">
                    <span>⇥</span>
                    Logout
                </a>

            </nav>

        </aside>

        <div class="admin-content">

            <main>
                @RenderBody()
            </main>

            <footer class="border-top footer text-muted admin-footer">
                <div class="container">
                    &copy; 2026 - Project_Hrms -
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Privacy">
                        Privacy
                    </a>
                </div>
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            $(document).ready(function () {
                $('table').not('.no-datatable').each(function () {
                    new DataTable(this);
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

