    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}


@model List<Trainings>

<div class="container-fluid">

    <!-- Page Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Training</h2>

            <div>
                <span>Performance</span>
                <span class="mx-2">/</span>
                <span>Training List</span>
            </div>
        </div>


        <!-- Add Training Button -->

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addTrainingModal">

            Add Training

        </button>

    </div>


    <!-- Training List -->

    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5>Training List</h5>

            <select id="sortTraining"
                    class="form-select w-auto">

                <option value="recent">
                    Recently Added
                </option>

                <option value="asc">
                    Ascending
                </option>

                <option value="desc">
                    Descending
                </option>

            </select>

        </div>


        <div class="card-body">

            <table id="trainingTable"
                   class="table table-bordered">

                <thead>

                    <tr>

                        <th>TrainingId</th>

                        <th>Trainer Name</th>

                        <th>Training Type</th>

                        <th>User (Employee)</th>

                        <th>Training Cost</th>

                        <th>Description</th>

                        <th>Status</th>

                        <th>Start Date</th>

                        <th>End Date</th>

                        <th>Action</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var d in Model)
                    {
                        <tr>

                            <td>
                                @d.TrainingId
                            </td>


                            <td>
                                @d.Trainer?.FirstName
                                @d.Trainer?.LastName
                            </td>


                            <td>
                                @d.TrainingType?.TrainingTypeName
                            </td>


                            <td>
                                @d.User?.FirstName
                                @d.User?.LastName
                            </td>


                            <td>
                                @d.TrainingCost
                            </td>


                            <td>
                                @d.Description
                            </td>


                            <td>

                                @if (d.Status == "Active")
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <td>
                                @d.StartDate.ToString("dd-MM-yyyy")
                            </td>


                            <td>
                                @d.EndDate.ToString("dd-MM-yyyy")
                            </td>


                            <td>

                             <div class="d-flex gap-1">
                                <!-- Edit -->

                                <button type="button"
                                        class="btn btn-sm btn-warning"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editTrainingModal_@d.TrainingId">

                                    Edit

                                </button>


                                <!-- Delete -->

                                      <form asp-controller="AddTrainingList"
                                      asp-action="DeleteTrainingList"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@d.TrainingId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Do you want to delete this record ?')">

                                        Delete

                                    </button>

                                </form>

                                </div>

                            </td>

                        </tr>


                        <!-- =============================== -->
                        <!-- EDIT TRAINING MODAL -->
                        <!-- =============================== -->

                        <div class="modal fade"
                             id="editTrainingModal_@d.TrainingId"
                             tabindex="-1">

                            <div class="modal-dialog modal-lg">

                                <div class="modal-content">

                                    <div class="modal-header">

                                        <h5 class="modal-title">
                                            Edit Training
                                        </h5>

                                        <button type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal">
                                        </button>

                                    </div>


                                    <div class="modal-body">

                                       <form asp-controller="AddTrainingList"
      asp-action="EditTrainingList"
      method="post">

                                            <input type="hidden"
                                                   name="TrainingId"
                                                   value="@d.TrainingId" />


                                            <div class="row">


                                                <!-- Trainer -->

                                                <div class="col-md-6 mb-3">
                                                    <label class="form-label">Trainer</label>

                                                    <select name="TrainerId" class="form-select">
                                                        @foreach (var trainer in ViewBag.Trainers)
                                                        {
                                                            <option value="@trainer.TrainerId"
                                                                    selected="@(trainer.TrainerId == d.TrainerId)">
                                                                @trainer.FirstName @trainer.LastName
                                                            </option>
                                                        }
                                                    </select>
                                                </div>


                                                <!-- Training Type -->

                                              <div class="col-md-6 mb-3">
                                                <label class="form-label">Training Type</label>

                                                <select name="TrainingTypeId" class="form-select">
                                                    @foreach (var type in ViewBag.TrainingTypes)
                                                    {
                                                        <option value="@type.TrainingTypeId"
                                                                selected="@(type.TrainingTypeId == d.TrainingTypeId)">
                                                            @type.TrainingTypeName
                                                        </option>
                                                    }
                                                </select>
                                            </div>


                                                <!-- Employee -->
                                                    <div class="col-md-6 mb-3">
                                                        <label class="form-label">Employee</label>

                                                        <select name="UserId" class="form-select">
                                                            @foreach (var employee in ViewBag.Employees)
                                                            {
                                                                <option value="@employee.UserId"
                                                                        selected="@(employee.UserId == d.UserId)">
                                                                    @employee.FirstName @employee.LastName
                                                                </option>
                                                            }
                                                        </select>
                                                    </div>


                                                <!-- Training Cost -->

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Training Cost
                                                    </label>

                                                    <input type="number"
                                                           step="0.01"
                                                           name="TrainingCost"
                                                           value="@d.TrainingCost"
                                                           class="form-control" />

                                                </div>


                                                <!-- Description -->

                                                <div class="col-12 mb-3">

                                                    <label class="form-label">
                                                        Description
                                                    </label>

                                                    <textarea name="Description"
                                                              class="form-control"
                                                              rows="4">@d.Description</textarea>

                                                </div>


                                                <!-- Status -->

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Status
                                                    </label>

                                                    <select name="Status"
                                                            class="form-select">

                                                        <option value="Active"
                                                                selected="@(d.Status == "Active")">

                                                            Active

                                                        </option>

                                                        <option value="Inactive"
                                                                selected="@(d.Status == "Inactive")">

                                                            Inactive

                                                        </option>

                                                    </select>

                                                </div>


                                                <!-- Start Date -->

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        Start Date
                                                    </label>

                                                    <input type="date"
                                                           name="StartDate"
                                                           value="@d.StartDate.ToString("yyyy-MM-dd")"
                                                           class="form-control" />

                                                </div>


                                                <!-- End Date -->

                                                <div class="col-md-6 mb-3">

                                                    <label class="form-label">
                                                        End Date
                                                    </label>

                                                    <input type="date"
                                                           name="EndDate"
                                                           value="@d.EndDate.ToString("yyyy-MM-dd")"
                                                           class="form-control" />

                                                </div>

                                            </div>


                                            <div class="text-end">

                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">

                                                    Cancel

                                                </button>

                                                <button type="submit"
                                                        class="btn btn-primary">

                                                    Update Training

                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- ================================================= -->
<!-- ADD TRAINING MODAL -->
<!-- ================================================= -->

<div class="modal fade"
     id="addTrainingModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">


            <div class="modal-header">

                <h5 class="modal-title">
                    Add Training
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


                        <div class="modal-body">

                            <form asp-controller="AddTrainingList"
                  asp-action="AddTrainingList"
                  method="post">

                  
                    <div class="row">


                        <!-- Trainer -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Trainer
                            </label>

                            <select name="TrainerId"
                                    class="form-select">

                                <option value="">
                                    Select Trainer
                                </option>

                                @if (ViewBag.Trainers != null)
                                {
                                    foreach (var trainer in ViewBag.Trainers)
                                    {
                                        <option value="@trainer.TrainerId">
                                            @trainer.FirstName @trainer.LastName
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- Training Type -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Training Type
                            </label>

                            <select name="TrainingTypeId"
                                    class="form-select">

                                <option value="">
                                    Select Training Type
                                </option>

                                @if (ViewBag.TrainingTypes != null)
                                {
                                    foreach (var type in ViewBag.TrainingTypes)
                                    {
                                        <option value="@type.TrainingTypeId">
                                            @type.TrainingTypeName
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- Employee -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Employee
                            </label>

                            <select name="UserId"
                                    class="form-select">

                                <option value="">
                                    Select Employee
                                </option>

                                @if (ViewBag.Employees != null)
                                {
                                    foreach (var employee in ViewBag.Employees)
                                    {
                                        <option value="@employee.UserId">
                                            @employee.FirstName @employee.LastName
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- Training Cost -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Training Cost
                            </label>

                            <input type="number"
                                   step="0.01"
                                   name="TrainingCost"
                                   class="form-control"
                                   placeholder="Enter training cost" />

                        </div>


                        <!-- Description -->

                        <div class="col-12 mb-3">

                            <label class="form-label">
                                Description
                            </label>

                            <textarea name="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter description"></textarea>

                        </div>


                        <!-- Status -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Status
                            </label>

                            <select name="Status"
                                    class="form-select">

                                <option value="">
                                    Select Status
                                </option>

                                <option value="Active">
                                    Active
                                </option>

                                <option value="Inactive">
                                    Inactive
                                </option>

                            </select>

                        </div>


                        <!-- Start Date -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Start Date
                            </label>

                            <input type="date"
                                   name="StartDate"
                                   class="form-control" />

                        </div>


                        <!-- End Date -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                End Date
                            </label>

                            <input type="date"
                                   name="EndDate"
                                   class="form-control" />

                        </div>

                    </div>


                    <div class="text-end">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-primary">

                            Add Training

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>



@section Scripts
{
    <script>

        $('#sortTraining').change(function() {

            var value = $(this).val();
            var table = $('table').DataTable();

            if (value == "recent") {

                table.order([0, 'desc']).draw();

            }
            else if (value == "asc") {

                table.order([0, 'asc']).draw();

            }
            else if (value == "desc") {

                table.order([0, 'desc']).draw();

            }

        });

    </script>
}