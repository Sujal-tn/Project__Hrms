    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<Trainers>

<div class="container-fluid">

   
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Trainers</h2>
        </div>

      
        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addTrainerModal">
            Add Trainer
        </button>

    </div>


    
    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">Trainer List</h5>

            <select id="sortTrainer"
                    class="form-select w-auto">
                <option value="recent">Recently Added</option>
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
            </select>

        </div>


        <div class="card-body">

            <table class="table table-bordered">

                <thead>
                    <tr>
                        <th>TrainerId</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>


                <tbody>

                    @foreach (var d in Model)
                    {
                        <tr>

                            <td>
                                @d.TrainerId
                            </td>

                            <td>
                                @d.FirstName @d.LastName
                            </td>

                            <td>
                                @d.Phone
                            </td>

                            <td>
                                @d.Email
                            </td>

                            <td>
                                @d.Description
                            </td>

                            <td>

                                @if (d.Status == "Active")
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td>

                                <button type="button"
                                        class="btn btn-sm btn-warning">
                                    Edit
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-danger">
                                    Delete
                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- ADD TRAINER MODAL -->

<div class="modal fade"
     id="addTrainerModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Add Trainer
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

           <div class="modal-body">

                    <form asp-controller="AddTrainer"
                      asp-action="AddTrainer"
                      method="post"
                      enctype="multipart/form-data">

                    <div class="row">

                        <!-- First Name -->
                        <div class="col-md-6 mb-3">
                            <label name="FirstName" class="form-label">
                                First Name
                            </label>

                            <input name="FirstName"
                                   class="form-control" />

                            <span class="text-danger">
                                @Html.ValidationMessage("FirstName")
                            </span>
                        </div>


                        <!-- Last Name -->
                        <div class="col-md-6 mb-3">
                            <label name ="LastName" class="form-label">
                                Last Name
                            </label>

                            <input name="LastName"
                                   class="form-control" />

                            <span class="text-danger">
                                @Html.ValidationMessage("LastName")
                            </span>
                        </div>


                        <!-- Phone -->
                        <div class="col-md-6 mb-3">
                            <label name="Phone" class="form-label">
                                Phone no
                            </label>

                            <input name="Phone"
                                   class="form-control" />
<span class="text-danger">
    @Html.ValidationMessage("Phone")
</span>
                        </div>


                        <!-- Image -->
                        <div class="col-md-6 mb-3">
                            <label name="Image" class="form-label">
                                Upload image
                            </label>

                            <input name="Image"
                                   type="file"
                                   class="form-control" />

                          
                        </div>


                        <!-- Role -->
                        <div class="col-md-6 mb-3">
                            <label name="Role" class="form-label">
                                Role
                            </label>

                            <select name="Role"
                                    class="form-select">

                                <option value="">
                                    Select Role
                                </option>

                                <option value="Trainer">
                                    Trainer
                                </option>

                                <option value="Senior Trainer">
                                    Senior Trainer
                                </option>

                            </select>
<span class="text-danger">
    @Html.ValidationMessage("Role")
</span>
                        </div>


                        <!-- Email -->
                        <div class="col-md-6 mb-3">
                            <label name="Email" class="form-label">
                                Email
                            </label>

                            <input name="Email"
                                   class="form-control" />

                            <span class="text-danger">
                                @Html.ValidationMessage("Email")
                            </span>
                        </div>


                        <!-- Description -->
                        <div class="col-12 mb-3">
                            <label name="Description" class="form-label">
                                Description
                            </label>

                            <textarea name="Description"
                                      class="form-control"
                                      rows="4"></textarea>

                            <span class="text-danger">
                                @Html.ValidationMessage("Description")
                            </span>
                        </div>


                        <!-- Status -->
                        <div class="col-12 mb-3">
                            <label name="Status" class="form-label">
                                Status
                            </label>

                            <select name="Status"
                                    class="form-select">

                                <option value="">
                                    Select
                                </option>

                                <option value="Active">
                                    Active
                                </option>

                                <option value="Inactive">
                                    Inactive
                                </option>

                            </select>

                            <span class="text-danger">
                                @Html.ValidationMessage("Status")
                            </span>
                        </div>

                    </div>


                    <!-- Buttons -->
                    <div class="text-end">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            Add Trainer
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>