@model Project_Hrms.Models.EmployeeModel.User

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Employee Details</h4>
            <p class="text-muted mb-0">Employee Profile</p>
        </div>
        <button class="btn btn-light border">
            <i class="ti ti-chevron-up"></i>
        </button>
    </div>
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="profile-cover"></div>
                <div class="card-body pt-0">
                    <div class="text-center profile-area">
                        @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                        {
                            <img src="~/@Model.ProfilePicture" class="profile-image" alt="Profile Picture" />
                        }
                        else
                        {
                            <div class="profile-image profile-placeholder">
                                <i class="ti ti-user"></i>
                            </div>
                        }
                        <h4 class="mt-3 mb-1">
                            @Model.FirstName @Model.LastName
                        </h4>
                        <span class="badge bg-light text-dark">
                            @Model.Designation?.DesignationName
                        </span>
                    </div>
                    <div class="employee-details mt-4">
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="ti ti-id"></i>
                                <span>Client ID</span>
                            </div>
                            <strong>@Model.UserId</strong>
                        </div>
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="ti ti-building"></i>
                                <span>Department</span>
                            </div>
                            <strong>
                                @(Model.Department?.DepartmentName ?? "Not Applicable")
                            </strong>
                        </div>
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="ti ti-calendar"></i>
                                <span>Date Of Joining</span>
                            </div>
                            <strong>@Model.DateOfJoining</strong>
                        </div>
                        <div class="detail-row">
                            <div class="detail-label">
                                <i class="ti ti-user"></i>
                                <span>Report Office</span>
                            </div>
                            <strong>
                                @Model.ReportingManager
                            </strong>
                        </div>
                    </div>
                    <a asp-controller="Emp" asp-action="EditEmp" asp-route-id="@Model.UserId"  class="btn btn-dark w-100 mt-4">
                      <i class="ti ti-edit me-2"></i> Edit Info
                    </a>
                </div>
                <div class="card-footer bg-white border-top p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">
                            Basic Information
                        </h5>
                        <a asp-controller="Emp" asp-action="EditEmp" asp-route-id="@Model.UserId"
                           class="text-dark">
                            <i class="ti ti-edit"></i>
                        </a>
                    </div>
                    <div class="basic-row">
                        <i class="ti ti-phone"></i>
                        <div>
                            <small>Phone</small>
                            <strong>@Model.PhoneNumber</strong>
                        </div>
                    </div>
                    <div class="basic-row">
                        <i class="ti ti-mail"></i>
                        <div>
                            <small>Email</small>
                            <strong class="text-primary">
                                @Model.Email
                            </strong>
                        </div>
                    </div>
                    <div class="basic-row">
                        <i class="ti ti-gender-male"></i>
                        <div>
                            <small>Gender</small>
                            <strong>@Model.Gender</strong>
                        </div>
                    </div>
                    <div class="basic-row">
                        <i class="ti ti-cake"></i>
                        <div>
                            <small>Birthday</small>
                            <strong>@Model.DateOfBirth</strong>
                        </div>
                    </div>
                    <div class="basic-row">
                        <i class="ti ti-map-pin"></i>
                        <div>
                            <small>Address</small>
                            <strong>@Model.Address</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        About Employee
                    </h5>
                    <div>
                        <button class="btn btn-sm btn-light">
                            <i class="ti ti-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-light">
                            <i class="ti ti-chevron-down"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-0">
                        @Model.AboutEmployee
                    </p>
                </div>
            </div>

           @*  Bank *@
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        Bank Information
                    </h5>
                    <div>
                        <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#editBankModal">
                            <i class="ti ti-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#addBankModal">
                            <i class="ti ti-plus"></i>
                        </button>
                        <button class="btn btn-sm btn-light">
                            <i class="ti ti-chevron-down"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.BankInformation != null)
                    {
                        <div class="row">     
                            <div class="col-md-6 mb-3">
                                <small class="text-muted">Bank Name</small>
                                @* <h6>@Model.BankI</h6> *@
                            </div>
                       </div>
                    } 

            </div>
           @*  Family
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        Family Information
                    </h5>
                    <div>
                        <button class="btn btn-sm btn-light">
                            <i class="ti ti-plus"></i>
                        </button>
                        <button class="btn btn-sm btn-light">
                            <i class="ti ti-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-light">
                            <i class="ti ti-chevron-down"></i>
                        </button>
                    </div>
                </div>
            </div>
            @* Education *@
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                Education Details
                            </h5>
                            <div>
                                <button class="btn btn-sm btn-light">
                                    <i class="ti ti-plus"></i>
                                </button>
                                <button class="btn btn-sm btn-light">
                                    <i class="ti ti-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-light">
                                    <i class="ti ti-chevron-down"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
               @*  Experience *@
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                Experience
                            </h5>
                            <div>
                                <button class="btn btn-sm btn-light">
                                    <i class="ti ti-plus"></i>
                                </button>
                                <button class="btn btn-sm btn-light">
                                    <i class="ti ti-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-light">
                                    <i class="ti ti-chevron-down"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>