@model IEnumerable<Project_Hrms.Models.MasterEvents>

<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">

    <div class="my-auto mb-2">

        <h2 class="mb-1">Event Types</h2>

        <nav>
            <ol class="breadcrumb mb-0">

                <li class="breadcrumb-item">
                    <a href="/">
                        <i class="ti ti-smart-home"></i>
                    </a>
                </li>

                <li class="breadcrumb-item">Event</li>
                <li class="breadcrumb-item active" aria-current="page">Event Types</li>

            </ol>
        </nav>

    </div>

</div>


<div class="row">

    <!-- Add Event Type -->

    <div class="col-xl-4 col-lg-5">

        <div class="card">

            <div class="card-header">
                <h5 class="mb-0">Add Event Type</h5>
            </div>

            <div class="card-body">

                <form asp-action="AddMasterEvent"
                      asp-controller="MasterEvents"
                      method="post">

                    <div class="mb-3">

                        <label class="form-label">
                            Event Type Name
                        </label>

                        <input type="text"
                               name="Name"
                               class="form-control"
                               placeholder="Enter Event Type Name"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Color
                        </label>

                        <input type="color"
                               name="Color"
                               class="form-control form-control-color"
                               value="#dd2727"
                               title="Choose your color" />

                        <span class="text-muted">
                            Choose a color for this event type
                        </span>

                    </div>


                    <button type="submit"
                            class="btn btn-primary">

                        Add Event Type

                    </button>

                </form>

            </div>

        </div>

    </div>


    <!-- Event Types List -->

<div class="col-xl-8 col-lg-7">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Event Types</h5>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Color</th>
                                <th>Sample</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Color</td>
                                    <td>
                                        <span style="display:inline-block;
                                                     width:25px;
                                                     height:25px;
                                                     background-color:@item.Color;
                                                     border-radius:4px;">
                                        </span>
                                    </td>
                                    <td>
                                        <form asp-action="DeleteMasterEvent" asp-controller="MasterEvents" asp-route-id="@item.Id" method="post"
                                              style="display:inline;"
                                              onsubmit="return confirm('Are you sure you want to delete this event type?');">

                                            <button type="submit" style="background:none;border:none">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>