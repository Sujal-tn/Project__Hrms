@{
    ViewData["Title"] = "Deduction";
    ViewData["PayrollActive"] = "Deduction";
}

<div class="payroll-top">
	<partial name="_PayrollMasterTabs" />

	<a href="#" id="opendeductionmodal" data-bs-target="#deduction" data-bs-toggle="modal" class="btn-payroll text-decoration-none">
		<i class="ti ti-circle-plus me-2"></i>Add Deduction
	</a>
</div>

<div class="card-body p-0">
	<div class="table-responsive">
		<table class="table payroll-table">
			<thead>
				<tr>
					<th>Id</th>
					<th>Deduction</th>
					<th>Deduction Percentage</th>
					<th>Department</th>
					<th>Designation</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody id="deductiondata">
			</tbody>
		</table>
	</div>
</div>

<!-- Add Deduction -->
<div class="modal fade payroll-modal" id="deduction" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered modal-md">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title">Add Deduction</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form method="post" id="deductionform">
					<div class="mb-3">
						<label class="form-label">Deduction Type</label>
						<select class="form-select" name="DeductionTypeId" asp-items="ViewBag.deductionType">
							<option value="">Select a Deduction Type</option>
						</select>
					</div>

					<div class="mb-3">
						<label class="form-label">Deduction Percentage</label>
						<input type="number" step="0.01" min="0" max="100" class="form-control" name="DeductionPercentage" placeholder="Enter percentage" />
					</div>

					<div class="mb-3">
						<label class="form-label">Department</label>
						<select class="form-select" name="DepartmentId" asp-items="ViewBag.department">
							<option value="">Select a Department</option>
						</select>
					</div>

					<div class="mb-3">
						<label class="form-label">Designation</label>
						<select class="form-select" name="DesignationId" asp-items="ViewBag.designation">
							<option value="">Select a Designation</option>
						</select>
					</div>
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-light border me-2" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn-payroll" id="adddeductionbtn">Add Deduction</button>
			</div>
		</div>
	</div>
</div>

<!-- Edit Deduction -->
<div class="modal fade payroll-modal" id="editdeduction" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered modal-md">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title">Edit Deduction</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form method="post" id="editdeductionform">
					<input type="hidden" name="DeductionId" id="editDeductionId" />

					<div class="mb-3">
						<label class="form-label">Deduction Type</label>
						<select class="form-select" name="DeductionTypeId" id="editDeductTypeId" asp-items="ViewBag.deductionType">
							<option value="">Select a Deduction Type</option>
						</select>
					</div>

					<div class="mb-3">
						<label class="form-label">Deduction Percentage</label>
						<input type="number" step="0.01" min="0" max="100" class="form-control" name="DeductionPercentage" id="editDeductionPercentage" />
					</div>

					<div class="mb-3">
						<label class="form-label">Department</label>
						<select class="form-select" name="DepartmentId" id="editDepartmentId" asp-items="ViewBag.department">
							<option value="">Select a Department</option>
						</select>
					</div>

					<div class="mb-3">
						<label class="form-label">Designation</label>
						<select class="form-select" name="DesignationId" id="editDesignationId" asp-items="ViewBag.designation">
							<option value="">Select a Designation</option>
						</select>
					</div>
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-light border me-2" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn-payroll" id="editdeductionbtn">Update Deduction</button>
			</div>
		</div>
	</div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/deductionjavascript.js"></script>
