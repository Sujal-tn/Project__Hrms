@model List<Project_Hrms.Models.Attendance>


<div class="container-fluid">

    <h2 class="mb-4" style="font-size:large">Attendance Report</h2>

    <div class="row">

        <!-- Cards -->
       <!-- Attendance Cards -->
<div class="col-md-6">

    <div class="row">

        <!-- Total Working Days -->
        <div class="col-6 mb-3">
            <div class="card text-center p-3">
                <h5>
                    <i class="bi bi-calendar-check text-danger"></i>
                    Total Working Days
                </h5>
                <p>@ViewBag.TotalWorkingDays</p>
            </div>
        </div>

        <!-- Total Leave Taken -->
        <div class="col-6 mb-3">
            <div class="card text-center p-3">
                <h5>
                    <i class="bi bi-calendar-x text-danger"></i>
                    Total Leave Taken
                </h5>
                <p>@ViewBag.TotalLeaveTaken</p>
            </div>
        </div>

        <!-- Total Holidays -->
        <div class="col-6 mb-3">
            <div class="card text-center p-3">
                <h5>
                    <i class="bi bi-sun text-danger"></i>
                    Total Holidays
                </h5>
                <p>@ViewBag.TotalHolidays</p>
            </div>
        </div>

        <!-- Total Halfdays -->
        <div class="col-6 mb-3">
            <div class="card text-center p-3">
                <h5>
                    <i class="bi bi-clock text-danger"></i>
                    Total Halfdays
                </h5>
                <p>@ViewBag.TotalHalfdays</p>
            </div>
        </div>

    </div>
</div>


        <!-- Chart -->
        <div class="col-md-6">

            <h5>
                <i class="bi bi-bar-chart-fill text-danger"></i>
                Attendance
            </h5>

            <canvas id="AttendanceLine"></canvas>

        </div>

    </div>

    <div class="card">
        <div class="card-body">

            <div class="row mb-3">

                <!-- Date Filter -->
                <div class="col-md-4">

                    <label for="dateFilter">
                        Select Date Filter:
                    </label>

                    <select id="dateFilter" class="form-control">

                        <option value="">
                            --Select Date Filter--
                        </option>

                        <option value="yesterday">
                            Yesterday
                        </option>

                        <option value="last7days">
                            Last 7 Days
                        </option>

                        <option value="last30days">
                            Last 30 Days
                        </option>

                        <option value="lastYear">
                            Last Year
                        </option>

                        <option value="thisYear">
                            This Year
                        </option>

                    </select>

                </div>


                <!-- Status Filter -->
                <div class="col-md-4">

                    <label for="statusFilter">
                        Select Status Filter:
                    </label>

                    <select id="statusFilter" class="form-control">

                        <option value="">
                            All
                        </option>

                        <option value="Present">
                            Present
                        </option>

                        <option value="Absent">
                            Absent
                        </option>

                        <option value="Half Day">
                            Half Day
                        </option>

                    </select>

                </div>


                <!-- Sorting Filter -->
                <div class="col-md-4">

                    <label for="sortOrder">
                        Sort By:
                    </label>

                    <select id="sortOrder" class="form-control">

                        <option value="">
                            --Select--
                        </option>

                        <option value="asc">
                            Ascending
                        </option>

                        <option value="desc">
                            Descending
                        </option>

                        <option value="last7days">
                            Last 7 Days
                        </option>

                        <option value="lastMonth">
                            Last Month
                        </option>

                    </select>

                </div>

            </div>

        </div>
    </div>
    

<div class="card mt-4">

    <div class="card-body">

        <h5 class="card-title mb-3">
            Attendance Report
        </h5>

        <div class="table-responsive">

            <table id="LeaveTable" class="table table-bordered table-hover">

                <thead class="table-light">
                    <tr>
                        <th>AttendanceId</th>
                        <th>Employee</th>
                        <th>Date</th>
                        <th>Check-In</th>
                        <th>Check-out</th>
                        <th>Lunch-In</th>
                        <th>Lunch-Out</th>
                        <th>Status</th>
                        <th>Working Hours</th>
                        <th>Overtime Hours</th>
                        <th>Break Hours</th>
                        <th>Late</th>
                        <th>Producation Hours</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var ar in Model)
                    {
                        <tr>

                            <td>@ar.AttendanceId</td>

                            <td>
                                @ar.User?.FirstName @ar.User?.LastName
                            </td>

                                
                                <td data-date="@ar.Date.ToString("yyyy-MM-dd")">
                                    @ar.Date.ToString("dd-MM-yyyy")
                                </td>

                            <td>@ar.CheckIn</td>

                            <td>@ar.CheckOut</td>

                            <td>@ar.LunchIn</td>
                            <td>@ar.LunchOut</td>
                            
                           
                            <td>

                                @if (ar.Status == "Present")
                                {
                                    <span class="badge bg-success">
                                        Present
                                    </span>
                                }
                                else if (ar.Status == "Half Day")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Half Day
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Absent
                                    </span>
                                }

                            </td>

                            <td>@ar.WorkingHours</td>
                            <td>@ar.OvertimeHours</td>
                            <td>@ar.BreakHours</td>
                            <td>@ar.Late</td>
                            <td>@ar.ProductionHours</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
    </div>
</div>

@section Scripts{

   <script>
            var monthlyAttendance = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                    ViewBag.MonthlyAttendance ?? new List<object>()
                            )
                    );

            console.log("Monthly Attendance:", monthlyAttendance);


            var labels = monthlyAttendance.map(x => x.Month);
            var present = monthlyAttendance.map(x => x.Present);
            var absent = monthlyAttendance.map(x => x.Absent);


            new Chart(document.getElementById('AttendanceLine'), {

                type: 'line',

                data: {
                    labels: labels,

                    datasets: [
                        {
                            label: 'Present',
                            data: present,
                            borderColor: 'red',
                            pointRadius: 5,
                            tension: 0.1
                        },
                        {
                            label: 'Absent',
                            data: absent,
                            borderColor: 'pink',
                            pointRadius: 5,
                            tension: 0.1
                        }
                    ]
                },

                options: {
                    responsive: true,

                    plugins: {
                        title: {
                            display: true,
                            text: 'Monthly Attendance'
                        }
                    }
                }

            });

        var table = $('#LeaveTable').DataTable();


        // ======================================
        // Attendance Custom Filter
        // ======================================

        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

            // Only apply to Attendance table
            if (settings.nTable.id !== 'LeaveTable') {
                return true;
            }


            // Get selected filters
            var selectedStatus = $('#statusFilter').val();
            var selectedDate = $('#dateFilter').val();
            var selectedSort = $('#sortOrder').val();


            // ======================================
            // STATUS FILTER
            // ======================================

            if (selectedStatus !== '') {

                var status = $('<div>')
                    .html(data[7])
                    .text()
                    .trim();

                if (status !== selectedStatus) {
                    return false;
                }
            }


            // ======================================
            // DATE
            // ======================================

            var dateCell = table.cell(dataIndex, 2).node();

            var dateValue = $(dateCell).attr('data-date');

            if (!dateValue) {
                return false;
            }

            var attendanceDate = new Date(dateValue);

            attendanceDate.setHours(0, 0, 0, 0);


            var today = new Date();

            today.setHours(0, 0, 0, 0);


            // ======================================
            // DATE FILTER
            // ======================================

            if (selectedDate === 'yesterday') {

                var yesterday = new Date(today);

                yesterday.setDate(today.getDate() - 1);

                if (attendanceDate.getTime() !== yesterday.getTime()) {
                    return false;
                }
            }


            if (selectedDate === 'last7days') {

                var sevenDaysAgo = new Date(today);

                sevenDaysAgo.setDate(today.getDate() - 7);

                if (attendanceDate < sevenDaysAgo ||
                    attendanceDate > today) {

                    return false;
                }
            }


            if (selectedDate === 'last30days') {

                var thirtyDaysAgo = new Date(today);

                thirtyDaysAgo.setDate(today.getDate() - 30);

                if (attendanceDate < thirtyDaysAgo ||
                    attendanceDate > today) {

                    return false;
                }
            }


            if (selectedDate === 'lastYear') {

                var lastYear = today.getFullYear() - 1;

                if (attendanceDate.getFullYear() !== lastYear) {
                    return false;
                }
            }


            if (selectedDate === 'thisYear') {

                if (attendanceDate.getFullYear() !== today.getFullYear()) {
                    return false;
                }
            }



            if (selectedSort === 'last7days') {

                var sevenDaysAgoSort = new Date(today);

                sevenDaysAgoSort.setDate(today.getDate() - 7);

                if (attendanceDate < sevenDaysAgoSort ||
                    attendanceDate > today) {

                    return false;
                }
            }


            

            if (selectedSort === 'lastMonth') {

                var firstDayLastMonth = new Date(
                    today.getFullYear(),
                    today.getMonth() - 1,
                    1
                );

                var lastDayLastMonth = new Date(
                    today.getFullYear(),
                    today.getMonth(),
                    0
                );

                if (attendanceDate < firstDayLastMonth ||
                    attendanceDate > lastDayLastMonth) {

                    return false;
                }
            }


            return true;

        });


      

        $('#statusFilter').on('change', function () {

            table.draw();

        });


      

        $('#dateFilter').on('change', function () {

            table.draw();

        });



        $('#sortOrder').on('change', function () {

            var sort = $(this).val();


            
            if (sort === 'asc') {

                table.order([0, 'asc']).draw();

            }


            else if (sort === 'desc') {

                table.order([0, 'desc']).draw();

            }


            
            else if (sort === 'last7days') {

                table.draw();

            }


           
            else if (sort === 'lastMonth') {

                table.draw();

            }

        });
        

</script>

}