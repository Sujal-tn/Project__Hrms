
@model List<Project_Hrms.Models.Tasks>

@{
    ViewData["Title"] = "Task Report";

    var totalTasks = Convert.ToInt32(ViewBag.TotalTasks ?? 0);
    var completedTasks = Convert.ToInt32(ViewBag.CompletedTasks ?? 0);
    var pendingTasks = Convert.ToInt32(ViewBag.PendingTasks ?? 0);
    var onHoldTasks = Convert.ToInt32(ViewBag.OnHold ?? 0);
    var inProgressTasks = Convert.ToInt32(ViewBag.InProgress ?? 0);
    var overdueTasks = Convert.ToInt32(ViewBag.Overdue ?? 0);
    var otherTasks = Convert.ToInt32(ViewBag.OtherTasks ?? 0);

    var completedPercentage = totalTasks > 0
        ? Math.Round((double)completedTasks / totalTasks * 100, 1)
        : 0;

    var pendingPercentage = totalTasks > 0
        ? Math.Round((double)pendingTasks / totalTasks * 100, 1)
        : 0;

    var inProgressPercentage = totalTasks > 0
        ? Math.Round((double)inProgressTasks / totalTasks * 100, 1)
        : 0;

    var onHoldPercentage = totalTasks > 0
        ? Math.Round((double)onHoldTasks / totalTasks * 100, 1)
        : 0;

    var overduePercentage = totalTasks > 0
        ? Math.Round((double)overdueTasks / totalTasks * 100, 1)
        : 0;
}

<div class="page-wrapper">

    <div class="content">

        <!-- Breadcrumb -->
        <div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">

            <div class="my-auto mb-2">

                <h2 class="mb-1">
                    Task Report
                </h2>

                <nav>
                    <ol class="breadcrumb mb-0">

                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Home")">
                                <i class="ti ti-smart-home"></i>
                            </a>
                        </li>

                        <li class="breadcrumb-item">
                            HR
                        </li>

                        <li class="breadcrumb-item active"
                            aria-current="page">
                            Task Report
                        </li>

                    </ol>
                </nav>

            </div>


            <div class="d-flex my-xl-auto right-content align-items-center flex-wrap">

                <!-- Export -->
                <div class="mb-2">

                    <div class="dropdown">

                        <a href="javascript:void(0);"
                           class="dropdown-toggle btn btn-white d-inline-flex align-items-center"
                           data-bs-toggle="dropdown">

                            <i class="ti ti-file-export me-1"></i>
                            Export

                        </a>

                        <ul class="dropdown-menu dropdown-menu-end p-3">

                            <li>

                                <a asp-action="TaskExportToPDF"
                                   asp-controller="ProjectTaskReport"
                                   class="dropdown-item rounded-1">

                                    <i class="ti ti-file-type-pdf me-1"></i>
                                    Export as PDF

                                </a>

                            </li>

                            <li>

                                <a asp-action="TaskExportToExcel"
                                   asp-controller="ProjectTaskReport"
                                   class="dropdown-item rounded-1">

                                    <i class="ti ti-file-type-xls me-1"></i>
                                    Export as Excel

                                </a>

                            </li>

                        </ul>

                    </div>

                </div>


                <!-- Collapse Header -->
                <div class="head-icons ms-2">

                    <a href="javascript:void(0);"
                       data-bs-toggle="tooltip"
                       data-bs-placement="top"
                       title="Collapse"
                       id="collapse-header">

                        <i class="ti ti-chevrons-up"></i>

                    </a>

                </div>

            </div>

        </div>
        <!-- /Breadcrumb -->


        <!-- Summary + Chart -->
        <div class="row">


            <!-- Summary Cards -->
            <div class="col-lg-6 col-md-6 d-flex">

                <div class="row flex-fill">


                    <!-- Total Tasks -->
                    <div class="col-lg-6 col-md-6 d-flex">

                        <div class="card flex-fill">

                            <div class="card-body">

                                <div class="row align-items-center">

                                    <div class="col-8">

                                        <div>

                                            <span class="fs-14 fw-normal text-truncate mb-1">
                                                Total Tasks
                                            </span>

                                            <h5>
                                                @totalTasks
                                            </h5>

                                        </div>

                                    </div>

                                    <div class="col-4 text-end">

                                        <p class="data-attributes mb-0">

                                            <span class="peity-chart"
                                                  data-peity='{
                                                    "fill": ["#F26522", "rgba(67, 87, 133, .09)"],
                                                    "innerRadius": 16,
                                                    "radius": 32
                                                  }'>
                                                1/1
                                            </span>

                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Completed -->
                    <div class="col-lg-6 col-md-6 d-flex">

                        <div class="card flex-fill">

                            <div class="card-body">

                                <div class="row align-items-center">

                                    <div class="col-8">

                                        <div>

                                            <span class="fs-14 fw-normal text-truncate mb-1">
                                                Completed Tasks
                                            </span>

                                            <h5>
                                                @completedTasks
                                            </h5>

                                        </div>

                                    </div>

                                    <div class="col-4 text-end">

                                        <p class="data-attributes mb-0">

                                            <span class="peity-chart"
                                                  data-peity='{
                                                    "fill": ["#03C95A", "rgba(67, 87, 133, .09)"],
                                                    "innerRadius": 16,
                                                    "radius": 32
                                                  }'>
                                                @completedPercentage/100
                                            </span>

                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Pending -->
                    <div class="col-lg-6 col-md-6 d-flex">

                        <div class="card flex-fill">

                            <div class="card-body">

                                <div class="row align-items-center">

                                    <div class="col-8">

                                        <div>

                                            <span class="fs-14 fw-normal text-truncate mb-1">
                                                Pending Tasks
                                            </span>

                                            <h5>
                                                @pendingTasks
                                            </h5>

                                        </div>

                                    </div>

                                    <div class="col-4 text-end">

                                        <p class="data-attributes mb-0">

                                            <span class="peity-chart"
                                                  data-peity='{
                                                    "fill": ["#F26522", "rgba(67, 87, 133, .09)"],
                                                    "innerRadius": 16,
                                                    "radius": 32
                                                  }'>
                                                @pendingPercentage/100
                                            </span>

                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Overdue -->
                    <div class="col-lg-6 col-md-6 d-flex">

                        <div class="card flex-fill">

                            <div class="card-body">

                                <div class="row align-items-center">

                                    <div class="col-8">

                                        <div>

                                            <span class="fs-14 fw-normal text-truncate mb-1">
                                                Overdue Tasks
                                            </span>

                                            <h5>
                                                @overdueTasks
                                            </h5>

                                        </div>

                                    </div>

                                    <div class="col-4 text-end">

                                        <p class="data-attributes mb-0">

                                            <span class="peity-chart"
                                                  data-peity='{
                                                    "fill": ["#03C95A", "rgba(67, 87, 133, .09)"],
                                                    "innerRadius": 16,
                                                    "radius": 32
                                                  }'>
                                                @overduePercentage/100
                                            </span>

                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
            <!-- /Summary Cards -->


            <!-- Task Chart -->
            <div class="col-lg-6 col-md-6 d-flex">

                <div class="card flex-fill">

                    <div class="card-header border-0">

                        <div class="d-flex flex-wrap justify-content-between align-items-center">

                            <div class="d-flex align-items-center">

                                <span class="me-2">
                                    <i class="ti ti-chart-pie text-danger"></i>
                                </span>

                                <h5 class="mb-0">
                                    Tasks
                                </h5>

                            </div>

                            <div class="dropdown">

                                <a href="javascript:void(0);"
                                   class="btn btn-sm fs-12 btn-white d-inline-flex align-items-center"
                                   data-bs-toggle="dropdown">

                                    Task Data

                                </a>

                            </div>

                        </div>

                    </div>


                    <div class="card-body pt-0">

                        <div class="row align-items-center">


                            <!-- Doughnut -->
                            <div class="col-md-6 d-flex align-items-center justify-content-center">

                                <div class="position-relative payment-total">

                                    <canvas id="pieChart"
                                            width="200"
                                            height="200">
                                    </canvas>

                                </div>

                            </div>


                            <!-- Legend -->
                            <div class="col-md-6">

                                <div class="row gy-4">


                                    <!-- Completed -->
                                    <div class="col-md-6">

                                        <div class="d-flex task-report-icons">

                                            <span class="me-2">
                                                <i class="ti ti-arrow-badge-right-filled text-success"></i>
                                            </span>

                                            <h6 class="fs-16 mb-0">

                                                Completed

                                                <span class="fs-14 fw-normal d-block">
                                                    @completedPercentage%
                                                </span>

                                            </h6>

                                        </div>

                                    </div>


                                    <!-- Pending -->
                                    <div class="col-md-6">

                                        <div class="d-flex task-report-icons">

                                            <span class="me-2">
                                                <i class="ti ti-arrow-badge-right-filled text-skyblue"></i>
                                            </span>

                                            <h6 class="fs-16 mb-0">

                                                Pending

                                                <span class="fs-14 fw-normal d-block">
                                                    @pendingPercentage%
                                                </span>

                                            </h6>

                                        </div>

                                    </div>


                                    <!-- In Progress -->
                                    <div class="col-md-6">

                                        <div class="d-flex task-report-icons">

                                            <span class="me-2">
                                                <i class="ti ti-arrow-badge-right-filled text-warning"></i>
                                            </span>

                                            <h6 class="fs-16 mb-0">

                                                In Progress

                                                <span class="fs-14 fw-normal d-block">
                                                    @inProgressPercentage%
                                                </span>

                                            </h6>

                                        </div>

                                    </div>


                                    <!-- On Hold -->
                                    <div class="col-md-6">

                                        <div class="d-flex task-report-icons">

                                            <span class="me-2">
                                                <i class="ti ti-arrow-badge-right-filled text-purple"></i>
                                            </span>

                                            <h6 class="fs-16 mb-0">

                                                On Hold

                                                <span class="fs-14 fw-normal d-block">
                                                    @onHoldPercentage%
                                                </span>

                                            </h6>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
            <!-- /Task Chart -->

        </div>


        <!-- Task List -->
        <div class="card">

            <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">

                <h5 class="mb-0">
                    Tasks List
                </h5>


                <!-- FILTER UI - LOGIC REMOVED FOR NOW -->
                <div class="d-flex my-xl-auto right-content align-items-center flex-wrap row-gap-3">

                    <div class="d-flex gap-3">


                        <!-- Priority -->
                        <select class="form-select"
                                id="priorityDropdown">

                            <option value="">
                                Select Priority
                            </option>

                            <option value="Low">
                                Low
                            </option>

                            <option value="Medium">
                                Medium
                            </option>

                            <option value="High">
                                High
                            </option>

                        </select>


                        <!-- Status -->
                        <select class="form-select"
                                id="statusDropdown">

                            <option value="">
                                Select Status
                            </option>

                            <option value="Completed">
                                Completed
                            </option>

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Inprogress">
                                Inprogress
                            </option>

                            <option value="Onhold">
                                Onhold
                            </option>

                        </select>


                        <!-- Sort -->
                        <select class="form-select"
                                id="sortDropdown">

                            <option value="">
                                Sort By
                            </option>

                            <option value="Recently Added">
                                Recently Added
                            </option>

                            <option value="Ascending">
                                Ascending
                            </option>

                            <option value="Descending">
                                Descending
                            </option>

                            <option value="Last Month">
                                Last Month
                            </option>

                            <option value="Last 7 Days">
                                Last 7 Days
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <div class="card-body p-0">

                <div class="custom-datatable-filter table-responsive">

                    <table class="table"
                           id="TaskTable">

                        <thead class="thead-light">

                            <tr>

                                <th>
                                    Task ID
                                </th>

                                <th>
                                    Task Name
                                </th>

                                <th>
                                    Project Name
                                </th>

                                <th>
                                    Assigned To
                                </th>

                                <th>
                                    Due Date
                                </th>

                                <th>
                                    Priority
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var t in Model)
                                {
                                    <tr>

                                        <!-- Task ID -->
                                        <td>
                                            @t.TaskId
                                        </td>


                                        <!-- Task Name -->
                                        <td>

                                            <span class="fw-medium">
                                                @t.Title
                                            </span>

                                        </td>


                                        <!-- Project -->
                                        <td>
                                            @t.Projects?.ProjectName
                                        </td>


                                        <!-- Assigned To -->
                                        <td>

                                            @if (t.Taskmember != null &&
                                           t.Taskmember.Any())
                                            {
                                                var members = t.Taskmember
                                                    .Where(x => x.User != null)
                                                    .Select(x =>
                                                        ((x.User.FirstName ?? "") + " " +
                                                         (x.User.LastName ?? "")).Trim())
                                                    .Where(x => !string.IsNullOrWhiteSpace(x))
                                                    .ToList();

                                                if (members.Any())
                                                {
                                                    <span>
                                                        @string.Join(", ", members)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        -
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    -
                                                </span>
                                            }

                                        </td>


                                        <!-- Deadline -->
                                        <td>
                                            @t.Deadline.ToString("yyyy-MM-dd")
                                        </td>


                                        <!-- Priority -->
                                        <td>

                                            @if (t.Priority == "High")
                                            {
                                                <span class="badge bg-danger d-inline-flex align-items-center">

                                                    <i class="ti ti-point-filled me-1"></i>
                                                    High

                                                </span>
                                            }
                                            else if (t.Priority == "Medium")
                                            {
                                                <span class="badge bg-warning text-dark d-inline-flex align-items-center">

                                                    <i class="ti ti-point-filled me-1"></i>
                                                    Medium

                                                </span>
                                            }
                                            else if (t.Priority == "Low")
                                            {
                                                <span class="badge bg-success d-inline-flex align-items-center">

                                                    <i class="ti ti-point-filled me-1"></i>
                                                    Low

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary d-inline-flex align-items-center">

                                                    <i class="ti ti-point-filled me-1"></i>
                                                    @(t.Priority ?? "-")

                                                </span>
                                            }

                                        </td>


                                        <!-- Status -->
                                        <td>

                                            @if (t.Status == "Completed")
                                            {
                                                <span class="badge bg-success d-inline-flex align-items-center">

                                                    <i class="ti ti-point-filled me-1"></i>
                                                    Completed

                                                </span>
                                            }
                                            else if (t.Status == "Onhold")
                                            {
                                                <span class="badge bg-warning text-dark d-inline-flex align-items-center">

                                                    <i class="ti ti-point-filled me-1"></i>
                                                    On Hold

                                                </span>
                                            }
                                            else if (t.Status == "Inprogress")
                                            {
                                                <span class="badge bg-primary d-inline-flex align-items-center">

                                                    <i class="ti ti-point-filled me-1"></i>
                                                    In Progress

                                                </span>
                                            }
                                            else if (t.Status == "Pending")
                                            {
                                                <span class="badge bg-danger d-inline-flex align-items-center">

                                                    <i class="ti ti-point-filled me-1"></i>
                                                    Pending

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary d-inline-flex align-items-center">

                                                    <i class="ti ti-point-filled me-1"></i>
                                                    @(t.Status ?? "-")

                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="7"
                                        class="text-center py-4">

                                        <span class="text-muted">
                                            No tasks found.
                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Peity -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/peity/3.3.0/jquery.peity.min.js"></script>


<script>

    $(document).ready(function () {

        // Peity charts
        $(".peity-chart").peity("pie");


        // Destroy existing DataTable if already initialized
        if ($.fn.DataTable.isDataTable("#TaskTable")) {
            $("#TaskTable").DataTable().destroy();
        }


        // Initialize DataTable
        var table = $("#TaskTable").DataTable({

            paging: true,

            searching: true,

            ordering: true,

            info: true,

            pageLength: 10,

            lengthMenu: [
                [10, 25, 50, 100],
                [10, 25, 50, 100]
            ],

            language: {

                search: "Search:",

                lengthMenu: "_MENU_ entries",

                info: "Showing _START_ to _END_ of _TOTAL_ entries",

                emptyTable: "No tasks found"

            }

        });


        /*
         * Custom Task Filters
         */
        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {

            // Only apply to TaskTable
            if (settings.nTable.id !== "TaskTable") {
                return true;
            }


            // Get selected filters
            var selectedPriority = $("#priorityDropdown").val();

            var selectedStatus = $("#statusDropdown").val();

            var selectedSort = $("#sortDropdown").val();


            /*
             * Priority Filter
             * Column 5 = Priority
             */
            if (selectedPriority !== "") {

                var tablePriority = $("<div>")
                    .html(data[5])
                    .text()
                    .trim();

                if (tablePriority !== selectedPriority) {
                    return false;
                }

            }


            /*
             * Status Filter
             * Column 6 = Status
             *
             * Badge displays:
             * In Progress
             * On Hold
             *
             * But database values are:
             * Inprogress
             * Onhold
             */
            if (selectedStatus !== "") {

                var tableStatus = $("<div>")
                    .html(data[6])
                    .text()
                    .trim();

                if (selectedStatus === "Inprogress") {

                    if (tableStatus !== "In Progress") {
                        return false;
                    }

                }
                else if (selectedStatus === "Onhold") {

                    if (tableStatus !== "On Hold") {
                        return false;
                    }

                }
                else {

                    if (tableStatus !== selectedStatus) {
                        return false;
                    }

                }

            }


            /*
             * Date Filter
             * Column 4 = Due Date
             */
            if (
                selectedSort === "Last Month" ||
                selectedSort === "Last 7 Days"
            ) {

                var dueDateText = $("<div>")
                    .html(data[4])
                    .text()
                    .trim();

                var dueDate = new Date(dueDateText);

                if (isNaN(dueDate.getTime())) {
                    return false;
                }

                var today = new Date();

                today.setHours(0, 0, 0, 0);

                var startDate = new Date(today);


                if (selectedSort === "Last 7 Days") {

                    startDate.setDate(
                        today.getDate() - 7
                    );

                }

                if (selectedSort === "Last Month") {

                    startDate.setMonth(
                        today.getMonth() - 1
                    );

                }


                return dueDate >= startDate &&
                       dueDate <= today;

            }


            return true;

        });


        /*
         * Priority Change
         */
        $("#priorityDropdown").on("change", function () {

            table.draw();

        });


        /*
         * Status Change
         */
        $("#statusDropdown").on("change", function () {

            table.draw();

        });


        /*
         * Sort Change
         */
        $("#sortDropdown").on("change", function () {

            var selectedSort = $(this).val();


            /*
             * Recently Added
             * Task ID descending
             */
            if (selectedSort === "Recently Added") {

                table
                    .order([0, "desc"])
                    .draw();

            }


            /*
             * Ascending
             * Task ID ascending
             */
            else if (selectedSort === "Ascending") {

                table
                    .order([0, "asc"])
                    .draw();

            }


            /*
             * Descending
             * Task ID descending
             */
            else if (selectedSort === "Descending") {

                table
                    .order([0, "desc"])
                    .draw();

            }


            /*
             * Last Month / Last 7 Days
             */
            else if (
                selectedSort === "Last Month" ||
                selectedSort === "Last 7 Days"
            ) {

                table.draw();

            }


            /*
             * Default
             */
            else {

                table
                    .order([])
                    .draw();

            }

        });

    });

</script>

}