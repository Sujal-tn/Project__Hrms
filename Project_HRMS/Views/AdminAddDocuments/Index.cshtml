    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<AdminAddDocumentsName>

<div class="container-fluid">

   
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Admin Document Name List</h2>

            <div>
                <span>Admin</span>
                <span class="mx-2">/</span>
                <span>Admin Document Name List</span>
            </div>
        </div>

        
        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addAdminDocumentsModal">

            Add Documents

        </button>

    </div>


  
    <div class="card">

        <div class="card-header">

            <h5>Admin Document Name List</h5>

        </div>


        <div class="card-body">

            <table id="adminDocumentTable" class="table table-bordered">

                <thead>

                    <tr>

                        <th>Document ID</th>

                        <th>Document Name</th>

                        <th>Action</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var d in Model)
                    {
                        <tr>

                           
                            <td>
                                @d.id
                            </td>


                           
                            <td>
                                @d.ADocumentName
                            </td>


                           
                            <td>

                               
                                <button type="button"
                                        class="btn btn-sm btn-warning"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editAdminDocumentModal_@d.id">

                                    Edit

                                </button>


                              
                                <form asp-controller="AdminAddDocuments"
                                      asp-action="DeleteAdminDocuments"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@d.id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Do you want to delete this document ?')">

                                        Delete

                                    </button>

                                </form>

                            </td>

                        </tr>


                       
                        <!--Edit Document Modal -->
                       

                        <div class="modal fade"
                             id="editAdminDocumentModal_@d.id"
                             tabindex="-1"
                             aria-hidden="true">

                            <div class="modal-dialog">

                                <div class="modal-content">

                                    <div class="modal-header">

                                        <h5 class="modal-title">
                                            Edit Admin Document Name
                                        </h5>

                                        <button type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal">
                                        </button>

                                    </div>


                                    <div class="modal-body">

                                        <form asp-controller="AdminAddDocuments"
                                              asp-action="EditAdminDocuments"
                                              method="post">

                                            <!-- Document ID -->
                                            <input type="hidden"
                                                   name="id"
                                                   value="@d.id" />


                                            <!-- Document Name -->
                                            <div class="mb-3">

                                                <label class="form-label">
                                                    Document Name
                                                </label>

                                                <input type="text"
                                                       name="ADocumentName"
                                                       value="@d.ADocumentName"
                                                       class="form-control"
                                                       placeholder="Enter Document Name"
                                                       required />

                                            </div>


                                            <!-- Buttons -->
                                            <div class="text-end">

                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">

                                                    Cancel

                                                </button>

                                                <button type="submit"
                                                        class="btn btn-primary">

                                                    Update

                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>



<!-- Add Admin Document Modal -->
<div class="modal fade"
     id="addAdminDocumentsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">


           
            <div class="modal-header">

                <h5 class="modal-title">
                    Add Admin Document Name
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


           
            <div class="modal-body">

                <form asp-controller="AdminAddDocuments"
                      asp-action="AddAdminDocuments"
                      method="post">


                   
                    <div class="mb-3">

                        <label class="form-label">
                            Document Name
                        </label>

                        <input type="text"
                               name="ADocumentName"
                               class="form-control"
                               placeholder="Enter Document Name"
                               required />

                    </div>


                   
                    <div class="text-end">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-primary">

                            Add

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>



@section Scripts
{
    <script>

        $(document).ready(function () {

            $('#adminDocumentTable').DataTable();

        });

    </script>
}