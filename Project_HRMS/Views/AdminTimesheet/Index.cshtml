@model List<Timesheet>

<div class="content">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">Admin Timesheet Management</h2>
        <div class="dropdown">

            <button class="btn btn-outline-secondary dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown">
                Export
            </button>

            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item" asp-action="ExportToPDF">
                        Export PDF
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-action="ExportTimesheets">
                        Export CSV
                    </a>
                </li>
            </ul>
        </div>
    </div>

    @if (TempData["msg"] != null)
    {
        <div class="alert alert-success">@TempData["msg"]</div>
    }

    <form id="timesheetForm" method="post">

        <!-- Bulk Action Buttons -->
        <div class="mb-3">
            <button type="submit" formaction="@Url.Action("Approve")" class="btn btn-success">Approve Selected</button>
            <button type="submit" formaction="@Url.Action("Reject")" class="btn btn-danger">Reject Selected</button>
        </div>

        <!-- Timesheet Table -->
        <div class="card">
            <div class="card-header">
                <h5>Timesheet</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="selectAll" /></th>
                            <th>Employee</th>
                            <th>Created At</th>
                            <th>Project</th>
                            <th>Worked Hours</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><input type="checkbox" name="ids" value="@item.TimesheetId" class="rowCheckbox" /></td>
                                <td>@item.User?.FirstName @item.User?.LastName</td>
                                <td>@item.Date.ToShortDateString()</td>
                                <td>@(item.Projects?.ProjectName ?? "N/A")</td>
                                <td>@item.WorkHours</td>
                                <td>
                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success">@item.Status</span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

<script>
    document.getElementById("selectAll").addEventListener("change", function () {
        document.querySelectorAll(".rowCheckbox").forEach(cb => cb.checked = this.checked);
    });
</script>