@model List<Project_Hrms.Models.TicketViewModels>
@{
    ViewData["Title"] = "Tickets";
    int currentUserId = ViewBag.CurrentUserId ?? 0;
    string userRole = ViewBag.UserRole ?? "Employee";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid">

    @if (TempData["addmssg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["addmssg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Tickets</h2>
            <small class="text-muted">Role: <span class="badge bg-secondary">@userRole</span></small>
        </div>

        <!-- Raise Ticket Button -->
        <button type="button"
                class="btn"
                style="background-color: #F26522; color: white;"
                data-bs-toggle="modal"
                data-bs-target="#addTicketModal">
            <i class="bi bi-plus-lg me-1"></i> Raise Ticket
        </button>
    </div>

    <!-- Ticket Card -->
    <div class="card">

        <!-- Card Header -->
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0">
                @(userRole == "Manager" ? "All Team Tickets" : "My Tickets")
            </h5>

            <div class="d-flex align-items-center gap-2 flex-wrap">

                <!-- Status Filter -->
                <select id="statusFilter" class="form-select" style="width: 140px;">
                    <option value="">All Status</option>
                    <option value="Open">Open</option>
                    <option value="Assigned">Assigned</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Resolved">Resolved</option>
                    <option value="Closed">Closed</option>
                    <option value="Reopened">Reopened</option>
                </select>

                <!-- Sorting Filter -->
                <select id="sortFilter" class="form-select" style="width: 150px;">
                    <option value="">Sort By</option>
                    <option value="asc">Ticket No A-Z</option>
                    <option value="desc">Ticket No Z-A</option>
                </select>

                <!-- Export Dropdown -->
                <div class="dropdown">
                    <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        Export
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button type="button" class="dropdown-item" id="exportPdf">Export as PDF</button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item" id="exportExcel">Export as Excel</button>
                        </li>
                    </ul>
                </div>

            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body">
            <div class="table-responsive">
                <table id="ticketTable" class="table table-bordered table-hover align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Ticket No</th>
                            <th>Subject</th>
                            <th>Raised By</th>
                            <th>Assigned To</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.TicketNo</strong></td>
                                    <td>
                                        <div class="fw-semibold">@item.Subject</div>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 200px;">@item.Description</small>
                                    </td>
                                    <td>@item.RaisedByName</td>
                                    <td>@item.AssignedToName</td>
                                    <td>
                                        @if (item.Priority == "High")
                                        {
                                            <span class="badge bg-danger">High</span>
                                        }
                                        else if (item.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning text-dark">Medium</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Low</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status == "Open")
                                        {
                                            <span class="badge bg-warning text-dark">Open</span>
                                        }
                                        else if (item.Status == "Assigned")
                                        {
                                            <span class="badge bg-info text-dark">Assigned</span>
                                        }
                                        else if (item.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary">In Progress</span>
                                        }
                                        else if (item.Status == "Resolved")
                                        {
                                            <span class="badge bg-success">Resolved</span>
                                        }
                                        else if (item.Status == "Closed")
                                        {
                                            <span class="badge bg-secondary">Closed</span>
                                        }
                                        else if (item.Status == "Reopened")
                                        {
                                            <span class="badge bg-danger">Reopened</span>
                                        }
                                    </td>
                                    <td>@item.FormattedDate</td>
                                    <td>
                                        <!-- 1. MANAGER ONLY: Assign Ticket (Checks userRole == "Manager") -->
                                        @if (userRole == "Manager" && (item.Status == "Open" || item.Status == "Reopened"))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm assignTicketButton me-1"
                                                    data-id="@item.TicketId"
                                                    data-ticketno="@item.TicketNo"
                                                    data-subject="@item.Subject"
                                                    data-assignedto="@item.AssignedToUserId"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#assignTicketModal"
                                                    title="Assign Ticket"
                                                    style="background-color: #0d6efd !important; color: #ffffff !important; border: 1px solid #0d6efd !important; padding: 4px 8px; border-radius: 4px;">
                                                <i class="bi bi-person-check"></i> Assign
                                            </button>
                                        }

                                        <!-- 2. ASSIGNED EMPLOYEE ONLY: Start Work -->
                                        @if (currentUserId == item.AssignedToUserId && item.Status == "Assigned")
                                        {
                                            <form asp-controller="Ticket" asp-action="StartWork" asp-route-id="@item.TicketId" method="post" class="d-inline">
                                                <button type="submit"
                                                        class="btn btn-sm me-1"
                                                        title="Start Work"
                                                        style="background-color: #0dcaf0 !important; color: #000000 !important; border: 1px solid #0dcaf0 !important; padding: 4px 8px; border-radius: 4px;">
                                                    <i class="bi bi-play-fill"></i> Start Work
                                                </button>
                                            </form>
                                        }

                                        <!-- 3. ASSIGNED EMPLOYEE ONLY: Submit Solution -->
                                        @if (currentUserId == item.AssignedToUserId && item.Status == "In Progress")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm solveTicketButton me-1"
                                                    data-id="@item.TicketId"
                                                    data-ticketno="@item.TicketNo"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#solutionModal"
                                                    title="Submit Solution"
                                                    style="background-color: #198754 !important; color: #ffffff !important; border: 1px solid #198754 !important; padding: 4px 8px; border-radius: 4px;">
                                                <i class="bi bi-check2-circle"></i> Submit Solution
                                            </button>
                                        }

                                        <!-- 4. SENDER EMPLOYEE ONLY: Confirm & Close or Reopen -->
                                        @if (currentUserId == item.RaisedByUserId && item.Status == "Resolved")
                                        {
                                            <form asp-controller="Ticket" asp-action="CloseTicket" asp-route-id="@item.TicketId" method="post" class="d-inline">
                                                <button type="submit"
                                                        class="btn btn-sm me-1"
                                                        title="Confirm & Close"
                                                        style="background-color: #198754 !important; color: #ffffff !important; border: 1px solid #198754 !important; padding: 4px 8px; border-radius: 4px;">
                                                    <i class="bi bi-check-lg"></i> Close
                                                </button>
                                            </form>

                                            <form asp-controller="Ticket" asp-action="ReopenTicket" asp-route-id="@item.TicketId" method="post" class="d-inline">
                                                <button type="submit"
                                                        class="btn btn-sm me-1"
                                                        title="Reopen Ticket"
                                                        style="background-color: #ffc107 !important; color: #000000 !important; border: 1px solid #ffc107 !important; padding: 4px 8px; border-radius: 4px;">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Reopen
                                                </button>
                                            </form>
                                        }

                                        <!-- 5. Status indicators when no action is required from current user -->
                                        @if (item.Status == "Closed")
                                        {
                                            <span class="badge bg-secondary">Closed</span>
                                        }
                                        else if (userRole != "Manager" && currentUserId != item.AssignedToUserId && currentUserId != item.RaisedByUserId)
                                        {
                                            <span class="text-muted small">No action</span>
                                        }

                                        <!-- Delete: Only Sender can delete while ticket is still Open -->
                                        @if (currentUserId == item.RaisedByUserId && item.Status == "Open")
                                        {
                                            <a asp-controller="Ticket"
                                               asp-action="DeleteTicket"
                                               asp-route-id="@item.TicketId"
                                               class="btn btn-sm"
                                               onclick="return confirm('Are you sure you want to delete this ticket?');"
                                               title="Delete"
                                               style="background-color: #dc3545 !important; color: #ffffff !important; border: 1px solid #dc3545 !important; padding: 4px 8px; border-radius: 4px; display: inline-block;">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="addTicketModal" tabindex="-1" aria-labelledby="addTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addTicketModalLabel">Raise New Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Ticket" asp-action="AddTicket" method="post">
                <div class="modal-body">
                    <!-- Subject -->
                    <div class="mb-3">
                        <label for="Subject" class="form-label fw-semibold">Subject <span class="text-danger">*</span></label>
                        <input type="text" id="Subject" name="Subject" class="form-control" placeholder="e.g. Laptop is not working" required />
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="Description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                        <textarea id="Description" name="Description" class="form-control" rows="3" placeholder="Enter issue details..." required></textarea>
                    </div>

                    <!-- Priority -->
                    <div class="mb-3">
                        <label for="Priority" class="form-label fw-semibold">Priority <span class="text-danger">*</span></label>
                        <select id="Priority" name="Priority" class="form-select" required>
                            <option value="Low">Low</option>
                            <option value="Medium" selected>Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn" style="background-color: #F26522; color: white;">Submit Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>



<div class="modal fade" id="assignTicketModal" tabindex="-1" aria-labelledby="assignTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignTicketModalLabel">Assign Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Ticket" asp-action="AssignTicket" method="post">
                <div class="modal-body">
                    <input type="hidden" id="assignTicketId" name="ticketId" />

                    <!-- Ticket No -->
                    <div class="mb-3">
                        <label class="form-label">Ticket</label>
                        <input type="text" id="assignTicketNo" class="form-control bg-light" readonly />
                    </div>

                    <!-- Assign To -->
                    <div class="mb-3">
                        <label for="assignedToUserId" class="form-label fw-semibold">Assign To Employee <span class="text-danger">*</span></label>
                        <select id="assignedToUserId" name="assignedToUserId" class="form-select" required>
                            <option value="">Select Employee</option>
                            @if (ViewBag.Users != null)
                            {
                                @foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.UserId">@user.FirstName @user.LastName</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Manager Note -->
                    <div class="mb-3">
                        <label for="managerNote" class="form-label fw-semibold">Manager Note</label>
                        <textarea id="managerNote" name="managerNote" class="form-control" rows="2" placeholder="Optional instructions..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn" style="background-color: #F26522; color: white;">Assign</button>
                </div>
            </form>
        </div>
    </div>
</div>



<div class="modal fade" id="solutionModal" tabindex="-1" aria-labelledby="solutionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="solutionModalLabel">Submit Solution</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Ticket" asp-action="SubmitSolution" method="post">
                <div class="modal-body">
                    <input type="hidden" id="solutionTicketId" name="ticketId" />

                    <div class="mb-3">
                        <label class="form-label">Ticket</label>
                        <input type="text" id="solutionTicketNo" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="solution" class="form-label fw-semibold">Solution Description <span class="text-danger">*</span></label>
                        <textarea id="solution" name="solution" class="form-control" rows="4" placeholder="Explain the resolution..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Submit Solution</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        $(document).ready(function() {
            var table = $('#ticketTable').DataTable({
                pageLength: 5,
                order: [[0, 'desc']],
                dom: '<"row mb-3"<"col-md-6"l><"col-md-6"f>>rt<"row mt-3"<"col-md-6"i><"col-md-6"p>>',
                buttons: [
                    { extend: 'excelHtml5', title: 'Ticket List', className: 'export-excel' },
                    { extend: 'pdfHtml5', title: 'Ticket List', orientation: 'landscape', pageSize: 'A4', className: 'export-pdf' }
                ]
            });

            $('.dt-buttons').hide();

            $('#statusFilter').on('change', function() {
                var statusValue = $(this).val();
                if (statusValue !== '') {
                    table.column(5).search('^' + statusValue + '$', true, false).draw();
                } else {
                    table.column(5).search('').draw();
                }
            });

            $('#sortFilter').on('change', function() {
                var sortValue = $(this).val();
                if (sortValue !== '') {
                    table.order([0, sortValue]).draw();
                }
            });

            $('#exportExcel').on('click', function() { table.button('.export-excel').trigger(); });
            $('#exportPdf').on('click', function() { table.button('.export-pdf').trigger(); });

            $(document).on('click', '.assignTicketButton', function() {
                var id = $(this).data('id');
                var ticketNo = $(this).data('ticketno');
                var subject = $(this).data('subject');
                var assignedTo = $(this).data('assignedto');

                $('#assignTicketId').val(id);
                $('#assignTicketNo').val(ticketNo + ' - ' + subject);
                $('#assignedToUserId').val(assignedTo || '');
            });

            $(document).on('click', '.solveTicketButton', function() {
                var id = $(this).data('id');
                var ticketNo = $(this).data('ticketno');

                $('#solutionTicketId').val(id);
                $('#solutionTicketNo').val(ticketNo);
            });
        });
    </script>
}
