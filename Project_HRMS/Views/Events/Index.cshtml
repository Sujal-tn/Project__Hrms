@model IEnumerable<Project_Hrms.Models.Events>

<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
    <div class="my-auto mb-2">
        <h2 class="mb-1">Events</h2>

        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/">
                        <i class="ti ti-smart-home"></i>
                    </a>
                </li>

                <li class="breadcrumb-item">
                    Event
                </li>

                <li class="breadcrumb-item active" aria-current="page">
                    Events List
                </li>
            </ol>
        </nav>
    </div>

    <div class="d-flex my-xl-auto right-content align-items-center flex-wrap">
        <div class="me-2">
            <button type="button"
                    class="btn btn-primary d-flex align-items-center"
                    id="btnmod"
                    data-bs-toggle="modal">
                <i class="ti ti-circle-plus me-2"></i>
                Add Event
            </button>
        </div>
    </div>
</div>


<div class="card">

    <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
        <h5 class="mb-0">Events Details</h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table" id="mytable">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Event Type</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.Id
                            </td>

                            <td>
                                @item.Title
                            </td>

                            <td>

                                <span class="badge d-inline-flex align-items-center badge-sm @(item.Status == "Active" ? "badge-success" : "badge-danger")">

                                    <i class="ti ti-point-filled me-1"></i>

                                    @item.Status

                                </span>

                            </td>

                            <td>
                                @item.Date
                            </td>

                            <td>
                                @item.EventTypeId
                            </td>

                            <td>

                                <!-- Edit Event Button -->

                                <button class="editEventBtn"
                                        type="button"
                                        style="background:none;border:none"
                                        data-id="@item.Id"
                                        data-title="@item.Title"
                                        data-date="@item.Date"
                                        data-type="@item.EventTypeId"
                                        data-status="@item.Status">

                                    <i class="ti ti-edit"></i>

                                </button>


                                <!-- Delete Event -->

                                <form asp-action="DeleteEvent"
                                      asp-controller="Events"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    <button type="submit"
                                            style="background:none;border:none">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- Add Event Modal -->

<div class="modal fade"
     id="addEventModal"
     tabindex="-1"
     aria-labelledby="addEventModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="addEventModalLabel">
                    Add New Event
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <form asp-action="AddEvent"
                      asp-controller="Events"
                      method="post">

                    <div class="mb-3">

                        <label class="form-label">
                            Event Title
                        </label>

                        <input type="text"
                               name="Title"
                               class="form-control"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Event Date
                        </label>

                        <input type="date"
                               name="Date"
                               class="form-control"
                               required />

                    </div>


                    <!-- Event Type Dropdown -->

                    <div class="mb-3">

                        <label class="form-label">
                            Event Type
                        </label>

                        <select name="EventTypeId"
                                class="form-control"
                                required>

                            <option value="">
                                Select Event Type
                            </option>

                            @foreach (var item in ViewBag.MasterEvents)
                            {
                                <option value="@item.Id">
                                    @item.Name
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Status Dropdown -->

                    <div class="mb-3">

                        <label class="form-label">
                            Status
                        </label>

                        <select name="Status"
                                class="form-control"
                                required>

                            <option value="">
                                Select Status
                            </option>

                            <option value="Active">
                                Active
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                    </div>


                    <button type="submit"
                            class="btn btn-primary">

                        Add Event

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- Edit Event Modal -->

<div class="modal fade"
     id="editEventModal"
     tabindex="-1"
     aria-labelledby="editEventModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="editEventModalLabel">
                    Edit Event
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <form asp-action="EditEvent"
                      asp-controller="Events"
                      method="post">

                    <input type="hidden"
                           id="editEventId"
                           name="Id" />


                    <div class="mb-3">

                        <label class="form-label">
                            Event Title
                        </label>

                        <input type="text"
                               id="editEventTitle"
                               name="Title"
                               class="form-control"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Event Date
                        </label>

                        <input type="date"
                               id="editEventDate"
                               name="Date"
                               class="form-control"
                               required />

                    </div>


                    <!-- Edit Event Type Dropdown -->

                    <div class="mb-3">

                        <label class="form-label">
                            Event Type
                        </label>

                        <select id="editEventType"
                                name="EventTypeId"
                                class="form-control"
                                required>

                            <option value="">
                                Select Event Type
                            </option>

                            @foreach (var item in ViewBag.MasterEvents)
                            {
                                <option value="@item.Id">
                                    @item.Name
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Edit Status Dropdown -->

                    <div class="mb-3">

                        <label class="form-label">
                            Status
                        </label>

                        <select id="editEventStatus"
                                name="Status"
                                class="form-control"
                                required>

                            <option value="">
                                Select Status
                            </option>

                            <option value="Active">
                                Active
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                    </div>


                    <button type="submit"
                            class="btn btn-primary">

                        Update Event

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>


    <script>

        $(document).ready(function () {

            // DataTable

            $('#mytable').DataTable({
                "paging": true,
                "pageLength": 5,
                "lengthMenu": [5, 10, 25, 50, 100],
                "ordering": true,
                "searching": true,
                "info": true,
                "responsive": true,
                "autoWidth": false
            });


            // Add Event Modal

            $('#btnmod').on('click', function () {

                $('#addEventModal').modal('show');

            });


            // Edit Event Button

            $(document).on('click', '.editEventBtn', function () {

                let eventId = $(this).data('id');

                let eventTitle = $(this).data('title');

                let eventDate = $(this).data('date');

                let eventType = $(this).data('type');

                let eventStatus = $(this).data('status');


                $('#editEventId').val(eventId);

                $('#editEventTitle').val(eventTitle);

                $('#editEventDate').val(eventDate);

                $('#editEventType').val(eventType);

                $('#editEventStatus').val(eventStatus);


                $('#editEventModal').modal('show');

            });

        });

    </script>

}