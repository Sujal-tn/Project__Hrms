@model IEnumerable<Project_Hrms.Models.Events>

<div id="main-content" class="d-flex">

    <div id="calendar"></div>

    <div id="sidebar-container">

        <div class="btn-add-event-container">
            <button class="btn btn-primary btn-add-event"
                    id="btnmod"
                    type="button">
                Add New Event
            </button>
        </div>

        <div id="event-sidebar">

            <ul class="event-list" id="eventList">

                @foreach (var item in Model)
                {
                    <li class="event-item">

                        <h6>@item.Title</h6>

                        <div class="event-date">
                            @item.Date
                        </div>

                    </li>
                }

            </ul>

        </div>

    </div>

</div>