@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<Project_Hrms.Models.ResignationViewModels>

@{
    ViewData["Title"] = "Resignation";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Resignations</h2>

        <button type="button"
                class="btn"
                style="background-color: #F26522; color: white;"
                data-bs-toggle="modal"
                data-bs-target="#addResignationModal">
            Add Resignation
        </button>
    </div>

    <!-- Resignation Card -->
    <div class="card">

        <!-- Card Header -->
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

            <h5 class="mb-0">Resignation List</h5>

            <div class="d-flex align-items-center gap-2 flex-wrap">

                <!-- Department Filter -->
                <select id="departmentFilter"
                        class="form-select"
                        style="width: 160px;">

                    <option value="">All Departments</option>
                    @if (ViewBag.Departments != null)
                    {
                        foreach (var dept in ViewBag.Departments)
                        {
                            <option value="@dept.DepartmentName">@dept.DepartmentName</option>
                        }
                    }
                </select>

                <!-- Sorting Filter -->
                <select id="sortFilter"
                        class="form-select"
                        style="width: 130px;">

                    <option value="">Sort By</option>
                    <option value="asc">Ascending</option>
                    <option value="desc">Descending</option>
                </select>

                <!-- Export Dropdown -->
                <div class="dropdown">

                    <button type="button"
                            class="btn dropdown-toggle"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Export
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportPdf">
                                Export as PDF
                            </button>
                        </li>

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportExcel">
                                Export as Excel
                            </button>
                        </li>

                    </ul>
                </div>

            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body">

            <div class="table-responsive">

                <table id="resignationTable"
                       class="table table-bordered table-hover align-middle w-100">

                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Notice Date</th>
                            <th>Resignation Date</th>
                            <th>Reason</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ResignationId</td>

                                <td>@item.EmployeeName</td>

                                <td>@item.DepartmentName</td>

                                <td>@item.NoticeDate.ToString("yyyy-MM-dd")</td>

                                <td>@item.ResignDate.ToString("yyyy-MM-dd")</td>

                                <td>@item.Reason</td>

                                <td>
                                    <!-- Edit Button -->
                                    <button type="button"
                                            class="btn btn-sm editResignationButton"
                                            data-id="@item.ResignationId"
                                            data-userid="@item.UserId"
                                            data-departmentid="@item.DepartmentId"
                                            data-noticedate="@item.NoticeDate.ToString("yyyy-MM-dd")"
                                            data-resigndate="@item.ResignDate.ToString("yyyy-MM-dd")"
                                            data-reason="@item.Reason"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editResignationModal"
                                            title="Edit">

                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <!-- Delete Button -->
                                    <form asp-controller="Resignation"
                                          asp-action="DeleteResignation"
                                          asp-route-id="@item.ResignationId"
                                          method="post"
                                          style="display: inline;">

                                        <button type="submit"
                                                class="btn btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this resignation?');"
                                                title="Delete">

                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    </div>
</div>


<!-- Add Resignation Modal -->
<div class="modal fade"
     id="addResignationModal"
     tabindex="-1"
     aria-labelledby="addResignationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="addResignationModalLabel">
                    Add Resignation
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form asp-controller="Resignation"
                  asp-action="AddResignation"
                  method="post">

                <div class="modal-body">

                    <div class="mb-3">
                        <label for="UserId" class="form-label">
                            Employee
                        </label>

                        <select id="UserId"
                                name="UserId"
                                class="form-select"
                                required>

                            <option value="">Select Employee</option>
                            @if (ViewBag.Users != null)
                            {
                                foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.UserId">
                                        @user.FirstName @user.LastName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="DepartmentId" class="form-label">
                            Department
                        </label>

                        <select id="DepartmentId"
                                name="DepartmentId"
                                class="form-select"
                                required>

                            <option value="">Select Department</option>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in ViewBag.Departments)
                                {
                                    <option value="@dept.DepartmentId">
                                        @dept.DepartmentName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="NoticeDate" class="form-label">
                            Notice Date
                        </label>

                        <input type="date"
                               id="NoticeDate"
                               name="NoticeDate"
                               class="form-control"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="ResignDate" class="form-label">
                            Resignation Date
                        </label>

                        <input type="date"
                               id="ResignDate"
                               name="ResignDate"
                               class="form-control"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="Reason" class="form-label">
                            Reason
                        </label>

                        <input type="text"
                               id="Reason"
                               name="Reason"
                               class="form-control"
                               placeholder="Enter reason"
                               required />
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Add Resignation
                    </button>

                </div>
            </form>

        </div>
    </div>
</div>


@* Edit Resignation Modal *@
<div class="modal fade"
     id="editResignationModal"
     tabindex="-1"
     aria-labelledby="editResignationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="editResignationModalLabel">
                    Edit Resignation
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form asp-controller="Resignation"
                  asp-action="EditResignation"
                  method="post"
                  novalidate>

                <div class="modal-body">

                    <input type="hidden"
                           id="editResignationId"
                           name="ResignationId" />

                    <div class="mb-3">
                        <label for="editUserId"
                               class="form-label">
                            Employee
                        </label>

                        <select id="editUserId"
                                name="UserId"
                                class="form-select">

                            <option value="">Select Employee</option>
                            @if (ViewBag.Users != null)
                            {
                                foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.UserId">
                                        @user.FirstName @user.LastName
                                    </option>
                                }
                            }
                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("UserId")
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="editDepartmentId"
                               class="form-label">
                            Department
                        </label>

                        <select id="editDepartmentId"
                                name="DepartmentId"
                                class="form-select">

                            <option value="">Select Department</option>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in ViewBag.Departments)
                                {
                                    <option value="@dept.DepartmentId">
                                        @dept.DepartmentName
                                    </option>
                                }
                            }
                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("DepartmentId")
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="editNoticeDate"
                               class="form-label">
                            Notice Date
                        </label>

                        <input type="date"
                               id="editNoticeDate"
                               name="NoticeDate"
                               class="form-control" />

                        <span class="text-danger">
                            @Html.ValidationMessage("NoticeDate")
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="editResignDate"
                               class="form-label">
                            Resignation Date
                        </label>

                        <input type="date"
                               id="editResignDate"
                               name="ResignDate"
                               class="form-control" />

                        <span class="text-danger">
                            @Html.ValidationMessage("ResignDate")
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="editReason"
                               class="form-label">
                            Reason
                        </label>

                        <input type="text"
                               id="editReason"
                               name="Reason"
                               class="form-control"
                               placeholder="Enter reason" />

                        <span class="text-danger">
                            @Html.ValidationMessage("Reason")
                        </span>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Update Resignation
                    </button>

                </div>
            </form>

        </div>
    </div>
</div>


@section Scripts {

    <!-- DataTables Core -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <!-- DataTables Buttons -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

    <!-- Excel Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <!-- PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <!-- HTML5 Export -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        $(document).ready(function() {

            var table = $('#resignationTable').DataTable({

                pageLength: 5,

                order: [[1, 'asc']],

                dom:
                    '<"row mb-3"<"col-md-6"l><"col-md-6"f>>' +
                    'rt' +
                    '<"row mt-3"<"col-md-6"i><"col-md-6"p>>',

                buttons: [
                    {
                        extend: 'excelHtml5',
                        title: 'Resignation List',
                        className: 'export-excel'
                    },
                    {
                        extend: 'pdfHtml5',
                        title: 'Resignation List',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        className: 'export-pdf'
                    }
                ]
            });

            // Hide original DataTables export buttons
            $('.dt-buttons').hide();


            // Department Filter
            $('#departmentFilter').on('change', function () {

                var dept = $(this).val();

                if (dept === '') {
                    table.column(2).search('').draw();
                }
                else {
                    table
                        .column(2)
                        .search('\\b' + dept + '\\b', true, false)
                        .draw();
                }

            });


            // Sort by Employee Name
            $('#sortFilter').on('change', function() {

                var sortValue = $(this).val();

                if (sortValue !== '') {
                    table.order([1, sortValue]).draw();
                }
            });


            // Export as Excel
            $('#exportExcel').on('click', function() {
                table.button('.export-excel').trigger();
            });


            // Export as PDF
            $('#exportPdf').on('click', function() {
                table.button('.export-pdf').trigger();
            });


            // Fill Edit Modal
            $('.editResignationButton').on('click', function() {

                var id = $(this).data('id');
                var userId = $(this).data('userid');
                var departmentId = $(this).data('departmentid');
                var noticeDate = $(this).data('noticedate');
                var resignDate = $(this).data('resigndate');
                var reason = $(this).data('reason');

                $('#editResignationId').val(id);
                $('#editUserId').val(userId);
                $('#editDepartmentId').val(departmentId);
                $('#editNoticeDate').val(noticeDate);
                $('#editResignDate').val(resignDate);
                $('#editReason').val(reason);
            });

        });
    </script>
}
