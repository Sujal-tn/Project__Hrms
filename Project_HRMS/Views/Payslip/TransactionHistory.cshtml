@model List<Payslips>

@{
    ViewData["Title"] = "Employee Salary Transaction History";
}

<partial name="Notification" />

<div class="d-md-flex d-block align-items-center justify-content-between page-breadcrumb mb-3">
    <div class="my-auto mb-2">
        <h2 class="mb-1">Transaction History</h2>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="index.html"><i class="ti ti-smart-home"></i></a></li>
                <li class="breadcrumb-item">HR</li>
                <li class="breadcrumb-item active" aria-current="page">Employee Salary</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap row-gap-3">
        <h5>Payslip List</h5>
        <div class="d-flex my-xl-auto right-content align-items-center flex-wrap row-gap-3">
            <div class="me-3">
                <select id="filterMonth" class="form-control">
                    <option value="">Select Month</option>
                    @foreach (var m in new[] { "January","February","March","April","May","June","July","August","September","October","November","December" })
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </div>
            <div class="me-3">
                <select id="filterYear" class="form-control">
                    <option value="">Select Year</option>
                    @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 10; i--)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>
            <div class="me-3">
                <select id="filterDepartment" class="form-control">
                    <option value="">Select Department</option>
                    @foreach (var department in ViewBag.Departments)
                    {
                        <option value="@department.DepartmentId">@department.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="me-3">
                <select id="filterDesignation" class="form-control">
                    <option value="">Select Designation</option>
                    @foreach (var designation in ViewBag.Designations)
                    {
                        <option value="@designation.DesignationId">@designation.DesignationName</option>
                    }
                </select>
            </div>
            <div>
                <button id="applyFiltersBtn" class="btn btn-primary">Apply Filters</button>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table display" id="payslipTable">
               <thead class="thead-light">
                    <tr>
                        <th>Emp ID</th>
                        <th>Employee</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Department</th>
                        <th>Generated On</th>
                        <th>Month / Year</th>
                        <th>Net Salary</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payslip in Model)
                    {
                        <tr>
                            <td>@payslip.User.UserId</td>
                            <td>
                                <div class="d-flex align-items-center file-name-icon">
                                    <a href="#" class="avatar avatar-md border avatar-rounded">
                                        <img src="~/@payslip.User.ProfilePicture" class="img-fluid" alt="Profile Picture" />
                                    </a>
                                    <div class="ms-2">
                                        <h6 class="fw-medium"><a href="#">@(payslip.User.FirstName + " " + payslip.User.LastName)</a></h6>
                                        <span class="fs-12 fw-normal">@payslip.User.Designation?.DesignationName</span>
                                    </div>
                                </div>
                            </td>
                            <td>@payslip.User.Email</td>
                            <td>@payslip.User.PhoneNumber</td>
                            <td>@payslip.User.Department?.DepartmentName</td>
                            <td>@payslip.GeneratedOn.ToString("dd/MM/yyyy")</td>
                            <td>@payslip.Month / @payslip.Year</td>
                            <td>@payslip.NetSalary.ToString("C")</td>
                            <td>
                                <a href="@Url.Action("GeneratePayslip", "Payslip", new { userId = payslip.User.UserId, month = payslip.Month, year = payslip.Year })">
                                    <i class="bi bi-eye"></i>
                                </a>
                                &nbsp;
                                <a href="@Url.Action("DownloadPayslip", "Payslip", new { payslipPath = payslip.PayslipPath })">
                                    <i class="ti ti-download"></i>
                                </a>
                                &nbsp;
                                <a href="@Url.Action("DeleteTransaction", "Payslip", new { payslipId = payslip.PayslipId })" onclick="return confirm('Are you sure you want to delete this payslip?')">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <link href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("applyFiltersBtn").addEventListener("click", function () {
                var query = "?month=" + encodeURIComponent(document.getElementById("filterMonth").value) +
                    "&year=" + encodeURIComponent(document.getElementById("filterYear").value) +
                    "&department=" + encodeURIComponent(document.getElementById("filterDepartment").value) +
                    "&designation=" + encodeURIComponent(document.getElementById("filterDesignation").value);
                window.location.href = "@Url.Action("TransactionHistory", "Payslip")" + query;
            });

            $('#payslipTable').DataTable({
                pageLength: 10,
                lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "All"]]
            });
        });
    </script>
}