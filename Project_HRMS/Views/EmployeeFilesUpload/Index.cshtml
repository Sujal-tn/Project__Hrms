    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model EmployeeFileUploadViewModel

<div class="container-fluid">

    
    <div class="mb-4">

        <h2>Employee FileUpload</h2>

        <div>
            <span>⌂</span>
            <span class="mx-2">/</span>
            <span>Employee</span>
            <span class="mx-2">/</span>
            <span>Employee FileUpload</span>
        </div>

    </div>


    
    <div class="card">

        <div class="card-header">
            <h5>Employee FileUpload</h5>
        </div>


        <div class="card-body p-4">

         
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }


           
            <form asp-controller="EmployeeFilesUpload"
                  asp-action="Index"
                  method="post"
                  enctype="multipart/form-data">


               
                <div class="mb-3">

                    <label class="form-label">
                        User
                    </label>

                    <select name="UserId"
                            class="form-select">

                        <option value="">
                            Select User
                        </option>

                        @if (ViewBag.Users != null)
                        {
                            foreach (var user in ViewBag.Users)
                            {
                                <option value="@user.UserId">
                                    @user.Email
                                </option>
                            }
                        }

                    </select>

                </div>


               
                <div id="documentContainer">

                   
                    <div class="document-row row g-3 mb-3">

                       
                        <div class="col-md-5">

                            <select name="Documents[0].DocumentId"
                                    class="form-select">

                                <option value="">
                                    Select Document
                                </option>

                                @if (ViewBag.DocumentNames != null)
                                {
                                    foreach (var document in ViewBag.DocumentNames)
                                    {
                                        <option value="@document.DocumentId">
                                            @document.DocumentName
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                       
                        <div class="col-md-5">

                            <input type="file"
                                   name="Documents[0].File"
                                   class="form-control" />

                        </div>


                        
                        <div class="col-md-2 d-flex align-items-center gap-2">

                            <button type="button"
                                    class="btn btn-primary add-row">
                                +
                            </button>

                            <button type="button"
                                    class="btn btn-link text-dark delete-row">
                                🗑
                            </button>

                        </div>

                    </div>

                </div>


               
                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Save
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        $(document).ready(function () {

           
            $(document).on('click', '.add-row', function () 
            {

                var row = $('.document-row:first').clone();
                row.find('select').val('');
                row.find('input[type="file"]').val('');
                $('#documentContainer').append(row);
                updateIndexes();

            });


            
            $(document).on('click', '.delete-row', function ()
            {
                if ($('.document-row').length > 1)
                {
                      $(this).closest('.document-row').remove();
                      updateIndexes();

                }

            });


          function updateIndexes() {

                $('.document-row').each(function (index) 
                {
                    $(this)
                        .find('select')
                        .attr( 'name', 'Documents[' + index + '].DocumentId'
                        );
 
                    $(this)
                        .find('input[type="file"]')
                        .attr(
                            'name',
                            'Documents[' + index + '].File'
                        );

                });

            }

        });

    </script>
}